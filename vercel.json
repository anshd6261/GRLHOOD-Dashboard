{
    "version": 2,
    "builds": [
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        },
        {
            "src": "src/server.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/src/server.js"
        },
        {
            "src": "/(.*)",
            "dest": "/frontend/$1"
        }
    ],
    "env": {
        "NODE_ENV": "production",
        "NBE_API_KEY": "@nbe-api-key",
        "NBE_API_BASE": "https://5060265239-api.nextbige.com/api/external",
        "SLACK_WEBHOOK_URL": "@slack-webhook-url"
    }
}
