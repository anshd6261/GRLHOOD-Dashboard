{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "npm install"
    },
    "deploy": {
        "startCommand": "node src/server.js",
        "healthcheckPath": "/api/status",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 3
    }
}
