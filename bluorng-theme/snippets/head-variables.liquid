{%- liquid
  assign font_body = settings.font_body
  assign font_heading = settings.font_heading
  assign font_body_bold = font_body | font_modify: 'weight', 'bold'
  assign font_heading_bold = font_heading | font_modify: 'weight', 'bold'
-%}

{% style %}
  {{ font_body | font_face: font_display: 'swap' }}
  {{ font_body_bold | font_face: font_display: 'swap' }}
  {{ font_heading | font_face: font_display: 'swap' }}
  {{ font_heading_bold | font_face: font_display: 'swap' }}

  :root {
    /* Colors - stored as R,G,B for rgba() usage */
    --color-background: {{ settings.color_background.red }},{{ settings.color_background.green }},{{ settings.color_background.blue }};
    --color-foreground: {{ settings.color_foreground.red }},{{ settings.color_foreground.green }},{{ settings.color_foreground.blue }};
    --color-button: {{ settings.color_button.red }},{{ settings.color_button.green }},{{ settings.color_button.blue }};
    --color-button-text: {{ settings.color_button_text.red }},{{ settings.color_button_text.green }},{{ settings.color_button_text.blue }};
    --color-link: {{ settings.color_link.red }},{{ settings.color_link.green }},{{ settings.color_link.blue }};
    --color-sale: {{ settings.color_sale.red }},{{ settings.color_sale.green }},{{ settings.color_sale.blue }};
    --color-badge-bg: {{ settings.color_badge_bg.red }},{{ settings.color_badge_bg.green }},{{ settings.color_badge_bg.blue }};
    --color-badge-text: {{ settings.color_badge_text.red }},{{ settings.color_badge_text.green }},{{ settings.color_badge_text.blue }};
    --color-border: {{ settings.color_border.red }},{{ settings.color_border.green }},{{ settings.color_border.blue }};
    --color-shadow: 18,18,18;

    /* Alpha values */
    --alpha-button-background: 1;
    --alpha-button-border: 1;
    --alpha-link: .85;
    --alpha-badge-border: .1;
    --border-opacity: {{ settings.border_opacity | divided_by: 100.0 }};

    /* Typography */
    --font-body-family: {{ font_body.family }}, {{ font_body.fallback_families }};
    --font-body-style: {{ font_body.style }};
    --font-body-weight: {{ font_body.weight }};
    --font-body-weight-bold: {{ font_body_bold.weight | default: 700 }};
    --font-heading-family: {{ font_heading.family }}, {{ font_heading.fallback_families }};
    --font-heading-style: {{ font_heading.style }};
    --font-heading-weight: {{ font_heading.weight }};
    --font-heading-weight-bold: {{ font_heading_bold.weight | default: 700 }};
    --font-body-scale: {{ settings.body_scale | divided_by: 100.0 }};
    --font-heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};

    /* Layout */
    --page-width: {{ settings.page_width | divided_by: 10.0 }}rem;
    --grid-desktop-horizontal-spacing: {{ settings.grid_horizontal_spacing }}px;
    --grid-desktop-vertical-spacing: {{ settings.grid_vertical_spacing }}px;
    --grid-mobile-horizontal-spacing: 4px;
    --grid-mobile-vertical-spacing: 4px;
    --grid-horizontal-spacing: var(--grid-desktop-horizontal-spacing);
    --grid-vertical-spacing: var(--grid-desktop-vertical-spacing);
    --section-spacing: {{ settings.section_spacing }}px;

    /* Buttons */
    --buttons-radius: {{ settings.buttons_border_radius }}px;
    --buttons-radius-outset: {{ settings.buttons_border_radius }}px;
    --buttons-border-width: {{ settings.buttons_border_width }}px;
    --buttons-border-radius: {{ settings.buttons_border_radius }}px;
    --buttons-border-opacity: 1.0;
    --variant-pills-radius: {{ settings.variant_pills_radius }}px;
    --variant-pills-border-width: 1px;
    --variant-pills-shadow-horizontal-offset: 0px;
    --variant-pills-shadow-vertical-offset: 0px;
    --variant-pills-shadow-blur-radius: 0px;
    --variant-pills-shadow-opacity: 0;

    /* Inputs */
    --inputs-radius: {{ settings.inputs_border_radius }}px;
    --inputs-border-radius: {{ settings.inputs_border_radius }}px;
    --inputs-border-width: {{ settings.inputs_border_width }}px;
    --inputs-border-opacity: 0.55;

    /* Product cards */
    --product-card-corner-radius: {{ settings.card_corner_radius }}px;
    --product-card-image-padding: {{ settings.card_image_padding }}rem;
    --card-corner-radius: {{ settings.card_corner_radius }}px;
    --card-image-padding: {{ settings.card_image_padding }}px;
    --card-text-alignment: {{ settings.card_text_alignment }};

    /* Media */
    --media-radius: 0px;
    --media-border-width: 0px;
    --media-border-opacity: 0;
    --media-shadow-visible: 0;
    --media-shadow-horizontal-offset: 0px;
    --media-shadow-vertical-offset: 0px;
    --media-shadow-blur-radius: 0px;
    --media-shadow-opacity: 0;

    /* Popup/drawer */
    --popup-border-width: 1px;
    --popup-border-opacity: .1;
    --popup-corner-radius: 0px;
    --popup-shadow-horizontal-offset: 0px;
    --popup-shadow-vertical-offset: 4px;
    --popup-shadow-blur-radius: 20px;
    --popup-shadow-opacity: .08;
    --drawer-border-width: 0px;
    --drawer-border-opacity: 1;
    --drawer-shadow-horizontal-offset: 0px;
    --drawer-shadow-vertical-offset: 0px;
    --drawer-shadow-blur-radius: 12px;
    --drawer-shadow-opacity: .12;

    /* Exact duration values from bluorng live theme (t/65) */
    --duration-short: .1s;
    --duration-default: .2s;
    --duration-announcement-bar: .25s;
    --duration-medium: .3s;
    --duration-long: .5s;
    --duration-extra-long: .6s;
    --duration-extra-longer: .75s;
    --duration-extended: 3s;

    /* Easing - exact from theme 65 */
    --ease-out-slow: cubic-bezier(0, 0, .3, 1);
    --animation-fade-in: fadeIn var(--duration-extra-long) var(--ease-out-slow);

    /* === BLUORNG CUSTOM DESIGN TOKENS (from live theme 65) === */
    --bg: #efefef;
    --secondary-bg: #ffffff;
    --header-scroll-text: #000000;
    --normal-text: #000000;
    --normal-header-svg: #717171;
    --header-scroll-svg: #adadad;
    --col-bg: #efefef;
    --secondary-text: #ffffff;
    --card-price: #000000;
    --special-text: #000000;
    --discover-btn: #ffffff;
    --discover-text: #000000;
    --search-input: #ececec;
    --gradient-bg: transparent linear-gradient(180deg, #ffffff, #efefef);
    --card-bg: #ffffff;
    --footer-gradient-bg: transparent linear-gradient(180deg, #FFFFFF 0%, #EFEFEF 100%);
    --pdp-variant: #f7f7f7;
    --pdp-border: #dbdbdb;
    --disable-variant-pill: #d9d9d9;
    --variant-pill-border: #dcdcdc;
    --variant-pill: #ffffff;
    --selected-variant-pill: #1c1c1c;
    --selected-variant-color: #ffffff;
    --buy-button: #000000;
    --safe-area-bg: transparent;
    --color-swatch: #ffffff;
    --wishlist-login-btn: #a8a8a8;
    --wishlist-sticky-bg: #cfcfcf;
    --careers-card-bg: #f6f6f6;
    --career-card-btn: #000000;
    --faq-acc: #fafafa;
    --footer-svg: #2d2d2d;
    --filter-btn: #e3e3e3;
    --border: #bdbdbd;
    --whishlist-btn: #000000;
    --sizechart-border: #e8e8e8;
    --selection: rgba(184, 173, 173, .5);
  }

  @media screen and (max-width: 749px) {
    :root {
      --grid-horizontal-spacing: var(--grid-mobile-horizontal-spacing);
      --grid-vertical-spacing: var(--grid-mobile-vertical-spacing);
    }
  }

  @keyframes fadeIn {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }

  @keyframes animateMenuOpen {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }
{% endstyle %}
