{{ 'component-story-viewer.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <!-- Story triggers -->
  <section class="stories" data-section-id="{{ section.id }}">
    <div class="stories__inner page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="stories__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="stories__list">
        {%- for block in section.blocks -%}
          <button class="stories__trigger" data-story-trigger="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="stories__trigger-image">
              {%- if block.settings.thumbnail != blank -%}
                <img
                  src="{{ block.settings.thumbnail | image_url: width: 120, height: 120, crop: 'center' }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  width="60"
                  height="60"
                >
              {%- elsif block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 120, height: 120, crop: 'center' }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  width="60"
                  height="60"
                >
              {%- else -%}
                <div class="stories__trigger-placeholder"></div>
              {%- endif -%}
            </div>
            {%- if block.settings.title != blank -%}
              <span class="stories__trigger-title">{{ block.settings.title }}</span>
            {%- endif -%}
          </button>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <!-- Story viewer modal -->
  <div class="story-viewer" data-story-viewer aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'sections.stories.viewer_label' | t }}">
    <div class="story-viewer__backdrop" data-story-close></div>

    <div class="story-viewer__container">
      <!-- Progress bars -->
      <div class="story-viewer__progress">
        {%- for block in section.blocks -%}
          <div class="story-viewer__progress-segment" data-story-progress="{{ forloop.index0 }}">
            <div class="story-viewer__progress-fill"></div>
          </div>
        {%- endfor -%}
      </div>

      <!-- Close button -->
      <button class="story-viewer__close" data-story-close aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon-close' %}
      </button>

      <!-- Story slides -->
      <div class="story-viewer__slides">
        {%- for block in section.blocks -%}
          <div class="story-viewer__slide" data-story-slide="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {%- if block.settings.video != blank -%}
              <video
                class="story-viewer__media story-viewer__media--video"
                src="{{ block.settings.video.sources[0].url }}"
                playsinline
                muted
                preload="none"
              ></video>
            {%- elsif block.settings.image != blank -%}
              <img
                class="story-viewer__media story-viewer__media--image"
                src="{{ block.settings.image | image_url: width: 1080 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
              >
            {%- endif -%}

            {%- if block.settings.overlay_text != blank or block.settings.button_label != blank -%}
              <div class="story-viewer__content">
                {%- if block.settings.overlay_text != blank -%}
                  <p class="story-viewer__text">{{ block.settings.overlay_text }}</p>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <a href="{{ block.settings.button_link }}" class="story-viewer__button btn btn--white">
                    {{ block.settings.button_label }}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <!-- Navigation -->
      <button class="story-viewer__nav story-viewer__nav--prev" data-story-prev aria-label="{{ 'general.slider.previous' | t }}">
        {% render 'icon-chevron', direction: 'left' %}
      </button>
      <button class="story-viewer__nav story-viewer__nav--next" data-story-next aria-label="{{ 'general.slider.next' | t }}">
        {% render 'icon-chevron', direction: 'right' %}
      </button>
    </div>
  </div>
{%- endif -%}

<script src="{{ 'component-story-viewer.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Story viewer",
  "class": "story-viewer-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Auto-advance duration per story",
      "min": 3,
      "max": 15,
      "step": 1,
      "default": 5,
      "unit": "s"
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail (optional)"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (optional, overrides image)"
        },
        {
          "type": "text",
          "id": "overlay_text",
          "label": "Overlay text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Story viewer",
      "blocks": [
        { "type": "story" },
        { "type": "story" },
        { "type": "story" }
      ]
    }
  ]
}
{% endschema %}
