<section class="account-page" data-section-id="{{ section.id }}">
  <div class="account-page__inner page-width">
    <div class="account-page__header">
      <h1 class="account-page__title">{{ 'customer.account.title' | t }}</h1>
      <a href="{{ routes.account_logout_url }}" class="account-page__logout">{{ 'customer.account.logout' | t }}</a>
    </div>

    <div class="account-page__grid">
      <!-- Order history -->
      <div class="account-page__orders">
        <h2 class="account-page__subtitle">{{ 'customer.account.order_history' | t }}</h2>

        {%- if customer.orders.size > 0 -%}
          <table class="account-page__orders-table">
            <thead>
              <tr>
                <th>{{ 'customer.orders.order_number' | t }}</th>
                <th>{{ 'customer.orders.date' | t }}</th>
                <th>{{ 'customer.orders.payment_status' | t }}</th>
                <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
                <th>{{ 'customer.orders.total' | t }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                  <td>{{ order.created_at | date: '%B %d, %Y' }}</td>
                  <td>{{ order.financial_status_label }}</td>
                  <td>{{ order.fulfillment_status_label }}</td>
                  <td>{{ order.total_price | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        {%- else -%}
          <p>{{ 'customer.account.no_orders' | t }}</p>
        {%- endif -%}
      </div>

      <!-- Account details -->
      <div class="account-page__details">
        <h2 class="account-page__subtitle">{{ 'customer.account.details' | t }}</h2>
        <p>{{ customer.name }}</p>
        <p>{{ customer.email }}</p>

        {%- if customer.default_address -%}
          <div class="account-page__address">
            {{ customer.default_address | format_address }}
          </div>
        {%- endif -%}

        <a href="{{ routes.account_addresses_url }}" class="account-page__link">{{ 'customer.account.view_addresses' | t }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer account",
  "class": "account-page-section",
  "settings": []
}
{% endschema %}
