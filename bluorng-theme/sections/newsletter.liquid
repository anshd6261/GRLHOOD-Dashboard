<section class="newsletter-section" data-section-id="{{ section.id }}">
  <div class="newsletter-section__inner page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="newsletter-section__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="newsletter-section__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- form 'customer', id: 'SectionNewsletter', class: 'newsletter-section__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter-section__field">
        <input
          type="email"
          name="contact[email]"
          class="newsletter-section__input input"
          placeholder="{{ 'sections.newsletter.placeholder' | t }}"
          required
          autocorrect="off"
          autocapitalize="off"
          aria-label="{{ 'sections.newsletter.placeholder' | t }}"
        >
        <button type="submit" class="newsletter-section__submit btn btn--primary">
          {{ 'sections.newsletter.submit' | t }}
        </button>
      </div>
      {%- if form.errors -%}
        <p class="newsletter-section__error">{{ form.errors.messages['email'] }}</p>
      {%- endif -%}
      {%- if form.posted_successfully? -%}
        <p class="newsletter-section__success">{{ 'sections.newsletter.success' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "class": "newsletter-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Subscribe to our newsletter"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Description"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
