<section class="account-page" data-section-id="{{ section.id }}">
  <div class="account-page__inner page-width">
    <a href="{{ routes.account_url }}" class="account-page__back">&larr; {{ 'customer.account.return' | t }}</a>
    <h1 class="account-page__title">{{ 'customer.order.title' | t: name: order.name }}</h1>

    <p class="account-page__order-date">
      {{ 'customer.order.date_html' | t: date: order.created_at | date: '%B %d, %Y' }}
    </p>

    {%- if order.cancelled -%}
      <div class="account-page__notice">
        {{ 'customer.order.cancelled_on' | t: date: order.cancelled_at | date: '%B %d, %Y' }}
        <br>{{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason_label }}
      </div>
    {%- endif -%}

    <table class="account-page__order-table">
      <thead>
        <tr>
          <th>{{ 'customer.order.product' | t }}</th>
          <th>{{ 'customer.order.sku' | t }}</th>
          <th>{{ 'customer.order.price' | t }}</th>
          <th>{{ 'customer.order.quantity' | t }}</th>
          <th>{{ 'customer.order.total' | t }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td>
              {{ line_item.title | link_to: line_item.product.url }}
              {%- if line_item.fulfillment -%}
                <p class="account-page__fulfillment">
                  {{ 'customer.order.fulfilled_at_html' | t: date: line_item.fulfillment.created_at | date: '%B %d, %Y' }}
                  {%- if line_item.fulfillment.tracking_url -%}
                    <a href="{{ line_item.fulfillment.tracking_url }}">{{ line_item.fulfillment.tracking_number }}</a>
                  {%- endif -%}
                </p>
              {%- endif -%}
            </td>
            <td>{{ line_item.sku }}</td>
            <td>{{ line_item.final_price | money }}</td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr>
          <td colspan="4">{{ 'customer.order.subtotal' | t }}</td>
          <td>{{ order.line_items_subtotal_price | money }}</td>
        </tr>
        {%- for discount_application in order.discount_applications -%}
          <tr>
            <td colspan="4">{{ 'customer.order.discount' | t }} ({{ discount_application.title }})</td>
            <td>-{{ discount_application.total_allocated_amount | money }}</td>
          </tr>
        {%- endfor -%}
        {%- for shipping_method in order.shipping_methods -%}
          <tr>
            <td colspan="4">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</td>
            <td>{{ shipping_method.price | money }}</td>
          </tr>
        {%- endfor -%}
        {%- for tax_line in order.tax_lines -%}
          <tr>
            <td colspan="4">{{ 'customer.order.tax' | t }} ({{ tax_line.title }} {{ tax_line.rate_percentage }}%)</td>
            <td>{{ tax_line.price | money }}</td>
          </tr>
        {%- endfor -%}
        <tr class="account-page__order-total">
          <td colspan="4">{{ 'customer.order.total' | t }}</td>
          <td>{{ order.total_price | money }}</td>
        </tr>
      </tfoot>
    </table>

    <div class="account-page__order-addresses">
      <div>
        <h3>{{ 'customer.order.billing_address' | t }}</h3>
        <p>{{ 'customer.order.payment_status' | t }}: {{ order.financial_status_label }}</p>
        {{ order.billing_address | format_address }}
      </div>
      <div>
        <h3>{{ 'customer.order.shipping_address' | t }}</h3>
        <p>{{ 'customer.order.fulfillment_status' | t }}: {{ order.fulfillment_status_label }}</p>
        {{ order.shipping_address | format_address }}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer order",
  "class": "account-page-section",
  "settings": []
}
{% endschema %}
