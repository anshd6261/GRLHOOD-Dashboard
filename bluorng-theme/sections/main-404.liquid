<section class="page-404" data-section-id="{{ section.id }}">
  <div class="page-404__inner page-width">
    <h1 class="page-404__title">{{ 'general.404.title' | t }}</h1>
    <p class="page-404__text">{{ 'general.404.subtext' | t }}</p>
    <a href="{{ routes.root_url }}" class="btn btn--primary page-404__btn">
      {{ 'general.404.back_home' | t }}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "404 page",
  "class": "page-404-section",
  "settings": []
}
{% endschema %}
