<section class="collection-list" data-section-id="{{ section.id }}">
  <div class="collection-list__inner page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="collection-list__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="collection-list__grid" data-columns-desktop="{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.collection.url | default: '#' }}" class="collection-list__card" {{ block.shopify_attributes }}>
          <div class="collection-list__card-image">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                alt="{{ block.settings.image.alt | default: block.settings.collection.title | escape }}"
                loading="lazy"
                width="600"
                height="{{ 600 | divided_by: block.settings.image.aspect_ratio }}"
              >
            {%- elsif block.settings.collection.image != blank -%}
              <img
                src="{{ block.settings.collection.image | image_url: width: 600 }}"
                alt="{{ block.settings.collection.title | escape }}"
                loading="lazy"
                width="600"
                height="{{ 600 | divided_by: block.settings.collection.image.aspect_ratio }}"
              >
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'collection-list__placeholder' }}
            {%- endif -%}
          </div>
          <p class="collection-list__card-title">
            {{ block.settings.title | default: block.settings.collection.title | default: 'Collection' }}
          </p>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "class": "collection-list-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
