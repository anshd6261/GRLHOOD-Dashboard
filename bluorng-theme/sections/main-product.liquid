{{ 'template-product.css' | asset_url | stylesheet_tag }}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<section class="product-page" data-section-id="{{ section.id }}" data-product-id="{{ product.id }}">
  <div class="product-page__inner page-width">
    <!-- Breadcrumbs -->
    <nav class="product-page__breadcrumbs" aria-label="Breadcrumb">
      <ol class="product-page__breadcrumb-list">
        <li><a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a></li>
        {%- if product.collections.size > 0 -%}
          <li><a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a></li>
        {%- endif -%}
        <li aria-current="page">{{ product.title }}</li>
      </ol>
    </nav>

    <div class="product-page__layout">
      <!-- Product gallery -->
      <div class="product-page__gallery">
        <div class="product-page__gallery-main" data-gallery-main>
          {%- for media in product.media -%}
            <div class="product-page__gallery-slide{% if forloop.first %} is-active{% endif %}" data-gallery-slide="{{ forloop.index0 }}" data-media-id="{{ media.id }}">
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  <button class="product-page__gallery-zoom" data-gallery-zoom="{{ forloop.index0 }}" aria-label="{{ 'products.product.media_open' | t }}">
                    <img
                      src="{{ media | image_url: width: 900 }}"
                      alt="{{ media.alt | escape }}"
                      loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                      width="{{ media.width }}"
                      height="{{ media.height }}"
                      class="product-page__gallery-image"
                    >
                  </button>
                {%- when 'video' -%}
                  <div class="product-page__gallery-video">
                    {{ media | video_tag: autoplay: false, loop: true, controls: true, muted: true }}
                  </div>
                {%- when 'external_video' -%}
                  <div class="product-page__gallery-video">
                    {{ media | external_video_tag }}
                  </div>
              {%- endcase -%}
            </div>
          {%- endfor -%}

          <div class="product-page__gallery-counter">
            <span data-gallery-current>1</span>/<span>{{ product.media.size }}</span>
          </div>
        </div>

        {%- if product.media.size > 1 -%}
          <div class="product-page__thumbnails" data-thumbnails>
            {%- for media in product.media -%}
              <button
                class="product-page__thumbnail{% if forloop.first %} is-active{% endif %}"
                data-thumbnail="{{ forloop.index0 }}"
                aria-label="{{ 'products.product.media_select' | t: index: forloop.index }}"
              >
                <img
                  src="{{ media | image_url: width: 150 }}"
                  alt="{{ media.alt | escape }}"
                  loading="lazy"
                  width="75"
                  height="{{ 75 | divided_by: media.aspect_ratio }}"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Product info -->
      <div class="product-page__info">
        <div class="product-page__info-inner">
          <!-- Vendor -->
          {%- if section.settings.show_vendor -%}
            <p class="product-page__vendor">{{ product.vendor }}</p>
          {%- endif -%}

          <!-- Title -->
          <h1 class="product-page__title">{{ product.title }}</h1>

          <!-- Price -->
          <div class="product-page__price" data-product-price>
            {% render 'price', product: product, use_variant: true %}
          </div>

          <!-- Tax / shipping notice -->
          {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
            <p class="product-page__tax-note">
              {%- if cart.taxes_included -%}
                {{ 'products.product.tax_included' | t }}
              {%- endif -%}
              {%- if shop.shipping_policy.body != blank -%}
                {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
              {%- endif -%}
            </p>
          {%- endif -%}

          <!-- Product form -->
          {%- form 'product', product, id: 'product-form', class: 'product-page__form', data-product-form: '' -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

            <!-- Variant selectors -->
            {%- unless product.has_only_default_variant -%}
              <div class="product-page__variants">
                {%- for option in product.options_with_values -%}
                  <div class="product-page__option" data-option-index="{{ forloop.index0 }}">
                    <label class="product-page__option-label">
                      {{ option.name }}
                      {%- if option.name == 'Size' and section.settings.show_size_guide -%}
                        <button type="button" class="product-page__size-guide-trigger" data-size-guide-toggle>
                          {{ 'products.product.size_guide' | t }}
                        </button>
                      {%- endif -%}
                    </label>

                    {%- if section.settings.variant_style == 'buttons' -%}
                      <div class="product-page__option-values product-page__option-values--buttons">
                        {%- for value in option.values -%}
                          {%- assign variant_available = true -%}
                          {%- if product.options.size == 1 -%}
                            {%- assign variant_available = product.variants | where: 'option1', value | map: 'available' | first -%}
                          {%- endif -%}
                          <label class="product-page__variant-btn{% unless variant_available %} product-page__variant-btn--unavailable{% endunless %}">
                            <input
                              type="radio"
                              name="option{{ forloop.parentloop.index }}"
                              value="{{ value | escape }}"
                              {% if option.selected_value == value %}checked{% endif %}
                              {% unless variant_available %}disabled{% endunless %}
                              data-option-input
                              class="visually-hidden"
                            >
                            <span class="product-page__variant-btn-label">{{ value }}</span>
                          </label>
                        {%- endfor -%}
                      </div>
                    {%- else -%}
                      <select class="product-page__option-select" name="option{{ forloop.index }}" data-option-input>
                        {%- for value in option.values -%}
                          <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>
                            {{ value }}
                          </option>
                        {%- endfor -%}
                      </select>
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              </div>
            {%- endunless -%}

            <!-- Quantity -->
            {%- if section.settings.show_quantity -%}
              <div class="product-page__quantity">
                <label for="Quantity" class="product-page__quantity-label">{{ 'products.product.quantity' | t }}</label>
                <div class="product-page__quantity-selector">
                  <button type="button" class="product-page__quantity-btn" data-quantity-minus aria-label="{{ 'products.product.quantity_decrease' | t }}">-</button>
                  <input
                    type="number"
                    id="Quantity"
                    name="quantity"
                    value="1"
                    min="1"
                    class="product-page__quantity-input"
                    data-quantity-input
                  >
                  <button type="button" class="product-page__quantity-btn" data-quantity-plus aria-label="{{ 'products.product.quantity_increase' | t }}">+</button>
                </div>
              </div>
            {%- endif -%}

            <!-- Add to cart -->
            <div class="product-page__submit">
              <button
                type="submit"
                class="product-page__add-to-cart btn btn--primary"
                {% unless current_variant.available %}disabled{% endunless %}
                data-add-to-cart
              >
                {%- if current_variant.available -%}
                  {{ 'products.product.add_to_cart' | t }}
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </button>

              {%- if section.settings.show_dynamic_checkout -%}
                {{ form | payment_button }}
              {%- endif -%}
            </div>
          {%- endform -%}

          <!-- Delivery estimate -->
          {%- if section.settings.show_delivery_estimate -%}
            <div class="product-page__delivery">
              <p class="product-page__delivery-text">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                {{ section.settings.delivery_text }}
              </p>
            </div>
          {%- endif -%}

          <!-- COD badge -->
          {%- if section.settings.show_cod_badge -%}
            <div class="product-page__cod">
              <p>{{ section.settings.cod_text }}</p>
            </div>
          {%- endif -%}

          <!-- Product description tabs -->
          <div class="product-page__tabs">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'description' -%}
                  <div class="product-page__tab" {{ block.shopify_attributes }}>
                    <button class="product-page__tab-trigger{% if forloop.first %} is-active{% endif %}" data-tab-trigger="{{ forloop.index0 }}" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
                      {{ block.settings.heading | default: 'Details & Description' }}
                      {% render 'icon-chevron', direction: 'down' %}
                    </button>
                    <div class="product-page__tab-content{% if forloop.first %} is-active{% endif %}" data-tab-content="{{ forloop.index0 }}">
                      {%- if block.settings.show_product_description -%}
                        <div class="product-page__description rte">
                          {{ product.description }}
                        </div>
                      {%- endif -%}
                      {%- if block.settings.custom_text != blank -%}
                        <div class="product-page__custom-text rte">
                          {{ block.settings.custom_text }}
                        </div>
                      {%- endif -%}
                    </div>
                  </div>

                {%- when 'custom_tab' -%}
                  <div class="product-page__tab" {{ block.shopify_attributes }}>
                    <button class="product-page__tab-trigger" data-tab-trigger="{{ forloop.index0 }}" aria-expanded="false">
                      {{ block.settings.heading }}
                      {% render 'icon-chevron', direction: 'down' %}
                    </button>
                    <div class="product-page__tab-content" data-tab-content="{{ forloop.index0 }}">
                      <div class="rte">{{ block.settings.content }}</div>
                    </div>
                  </div>

                {%- when 'shipping_tab' -%}
                  <div class="product-page__tab" {{ block.shopify_attributes }}>
                    <button class="product-page__tab-trigger" data-tab-trigger="{{ forloop.index0 }}" aria-expanded="false">
                      {{ block.settings.heading | default: 'Shipping' }}
                      {% render 'icon-chevron', direction: 'down' %}
                    </button>
                    <div class="product-page__tab-content" data-tab-content="{{ forloop.index0 }}">
                      <div class="rte">
                        {%- if block.settings.content != blank -%}
                          {{ block.settings.content }}
                        {%- else -%}
                          <ul>
                            <li>Packed within 24 hours</li>
                            <li>Free delivery Pan-India</li>
                            <li>Dispatches Next Day</li>
                          </ul>
                        {%- endif -%}
                      </div>
                    </div>
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Size guide modal -->
  {%- if section.settings.show_size_guide -%}
    <div class="size-guide-modal" data-size-guide-modal aria-hidden="true" role="dialog" aria-modal="true">
      <div class="size-guide-modal__backdrop" data-size-guide-close></div>
      <div class="size-guide-modal__content">
        <div class="size-guide-modal__header">
          <h3>{{ 'products.product.size_guide' | t }}</h3>
          <button class="size-guide-modal__close" data-size-guide-close aria-label="{{ 'accessibility.close' | t }}">
            {% render 'icon-close' %}
          </button>
        </div>
        <div class="size-guide-modal__body">
          {%- if section.settings.size_guide_page != blank -%}
            {{ section.settings.size_guide_page.content }}
          {%- else -%}
            <div class="size-guide-modal__tabs">
              <button class="size-guide-modal__tab is-active" data-unit-tab="in">IN</button>
              <button class="size-guide-modal__tab" data-unit-tab="cm">CM</button>
            </div>
            <p class="size-guide-modal__note">{{ 'products.product.size_guide_note' | t }}</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <!-- Image zoom modal -->
  <div class="zoom-modal" data-zoom-modal aria-hidden="true" role="dialog" aria-modal="true">
    <div class="zoom-modal__backdrop" data-zoom-close></div>
    <div class="zoom-modal__content">
      <button class="zoom-modal__close" data-zoom-close aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon-close' %}
      </button>
      <img class="zoom-modal__image" data-zoom-image src="" alt="">
    </div>
  </div>

  <script type="application/json" data-product-json>
    {{ product | json }}
  </script>
</section>

{% schema %}
{
  "name": "Product page",
  "class": "product-page-section",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "Enable image zoom modal",
      "default": true
    },
    {
      "type": "header",
      "content": "Product info"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "select",
      "id": "variant_style",
      "label": "Variant selector style",
      "options": [
        { "value": "buttons", "label": "Buttons" },
        { "value": "dropdown", "label": "Dropdown" }
      ],
      "default": "dropdown"
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity selector",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout buttons",
      "default": true
    },
    {
      "type": "header",
      "content": "Delivery & trust"
    },
    {
      "type": "checkbox",
      "id": "show_delivery_estimate",
      "label": "Show delivery estimate",
      "default": true
    },
    {
      "type": "text",
      "id": "delivery_text",
      "label": "Delivery text",
      "default": "Free delivery Pan-India. Dispatches Next Day."
    },
    {
      "type": "checkbox",
      "id": "show_cod_badge",
      "label": "Show COD badge",
      "default": true
    },
    {
      "type": "text",
      "id": "cod_text",
      "label": "COD text",
      "default": "Cash On Delivery Available"
    },
    {
      "type": "header",
      "content": "Size guide"
    },
    {
      "type": "checkbox",
      "id": "show_size_guide",
      "label": "Show size guide",
      "default": true
    },
    {
      "type": "page",
      "id": "size_guide_page",
      "label": "Size guide page (optional)"
    }
  ],
  "blocks": [
    {
      "type": "description",
      "name": "Description tab",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Tab heading",
          "default": "Details & Description"
        },
        {
          "type": "checkbox",
          "id": "show_product_description",
          "label": "Show product description",
          "default": true
        },
        {
          "type": "richtext",
          "id": "custom_text",
          "label": "Additional custom text"
        }
      ]
    },
    {
      "type": "custom_tab",
      "name": "Custom tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Tab heading",
          "default": "Washcare"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Tab content"
        }
      ]
    },
    {
      "type": "shipping_tab",
      "name": "Shipping tab",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Tab heading",
          "default": "Shipping"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Custom shipping content (leave blank for defaults)"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "description",
        "settings": {
          "heading": "Details & Description"
        }
      },
      {
        "type": "custom_tab",
        "settings": {
          "heading": "Washcare"
        }
      },
      {
        "type": "shipping_tab",
        "settings": {
          "heading": "Shipping"
        }
      }
    ]
  }
}
{% endschema %}
