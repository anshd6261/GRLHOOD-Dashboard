<section class="account-page" data-section-id="{{ section.id }}">
  <div class="account-page__inner page-width">
    <h1 class="account-page__title">{{ 'customer.reset_password.title' | t }}</h1>

    <div class="account-page__form-wrapper">
      {%- form 'reset_customer_password', class: 'account-page__form' -%}
        {%- if form.errors -%}
          <div class="account-page__errors">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <div class="account-page__field">
          <label for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
          <input type="password" id="ResetPassword" name="customer[password]" required class="input">
        </div>

        <div class="account-page__field">
          <label for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
          <input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" required class="input">
        </div>

        <button type="submit" class="btn btn--primary">{{ 'customer.reset_password.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reset password",
  "class": "account-page-section",
  "settings": []
}
{% endschema %}
