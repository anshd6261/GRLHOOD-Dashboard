{%- comment -%}
  GRL — Custom product media gallery (renders INSIDE the gallery block).
  Per-device controls: Desktop / Tablet / Mobile each get their own layout,
  sizing, padding, background and navigation style (thumbnails / pager / none).
  Mobile gets its own pager group (pill / count / dots, overlay or below).
  Uses data-grl-mid (NOT data-media-id) to stay decoupled from the legacy
  __grlFI variant script. Params: block, product (closest.product)
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign gid = 'grlmg-' | append: block.id | replace: ':', '-'

  # ---------- Desktop ----------
  assign d_nav = s.grl_d_nav | default: 'thumbs'
  assign d_pos = s.grl_d_pos | default: 'left'
  assign d_valign = s.grl_d_valign | default: 'center'
  assign d_thumb_w = s.grl_d_thumb_w | default: 64
  assign d_thumb_gap = s.grl_d_thumb_gap | default: 8
  assign d_thumb_aspect = s.grl_d_thumb_aspect | default: '1/1.18'
  assign d_gap = s.grl_d_gap | default: 12
  assign d_aspect = s.grl_d_aspect | default: '3/3.75'
  assign d_fit = s.grl_d_fit | default: 'contain'
  assign d_radius = s.grl_d_radius | default: 16
  assign d_bg = s.grl_d_bg | default: '#f4f4f4'
  assign d_maxh = s.grl_d_maxh | default: 0
  assign d_maxw = s.grl_d_maxw | default: 0
  assign d_minh = s.grl_d_minh | default: 0
  assign d_scale = s.grl_d_scale | default: 100
  assign d_pt = s.grl_d_pt | default: 0
  assign d_pb = s.grl_d_pb | default: 0
  assign d_pl = s.grl_d_pl | default: 0
  assign d_pr = s.grl_d_pr | default: 0

  # ---------- Tablet ----------
  assign t_nav = s.grl_t_nav | default: 'thumbs'
  assign t_pos = s.grl_t_pos | default: 'left'
  assign t_valign = s.grl_t_valign | default: 'center'
  assign t_thumb_w = s.grl_t_thumb_w | default: 56
  assign t_thumb_gap = s.grl_t_thumb_gap | default: 8
  assign t_thumb_aspect = s.grl_t_thumb_aspect | default: '1/1.18'
  assign t_gap = s.grl_t_gap | default: 10
  assign t_aspect = s.grl_t_aspect | default: '3/3.75'
  assign t_fit = s.grl_t_fit | default: 'contain'
  assign t_radius = s.grl_t_radius | default: 16
  assign t_bg = s.grl_t_bg | default: '#f4f4f4'
  assign t_maxh = s.grl_t_maxh | default: 0
  assign t_pt = s.grl_t_pt | default: 0
  assign t_pb = s.grl_t_pb | default: 0
  assign t_pl = s.grl_t_pl | default: 0
  assign t_pr = s.grl_t_pr | default: 0

  # ---------- Mobile ----------
  assign m_nav = s.grl_m_nav | default: 'pager'
  assign m_pos = s.grl_m_pos | default: 'bottom'
  assign m_valign = s.grl_m_valign | default: 'center'
  assign m_thumb_w = s.grl_m_thumb_w | default: 46
  assign m_thumb_gap = s.grl_m_thumb_gap | default: 6
  assign m_thumb_aspect = s.grl_m_thumb_aspect | default: '1/1.18'
  assign m_gap = s.grl_m_gap | default: 8
  assign m_aspect = s.grl_m_aspect | default: '3/3.75'
  assign m_fit = s.grl_m_fit | default: 'contain'
  assign m_radius = s.grl_m_radius | default: 14
  assign m_bg = s.grl_m_bg | default: '#ffffff'
  assign m_maxh = s.grl_m_maxh | default: 0
  assign m_maxw = s.grl_m_maxw | default: 0
  assign m_minh = s.grl_m_minh | default: 0
  assign m_scale = s.grl_m_scale | default: 100
  assign m_pt = s.grl_m_pt | default: 0
  assign m_pb = s.grl_m_pb | default: 0
  assign m_pl = s.grl_m_pl | default: 0
  assign m_pr = s.grl_m_pr | default: 0

  # ---------- shared style ----------
  assign fade_ms = s.grl_fade_duration | default: 280
  assign fade_ease = s.grl_fade_easing | default: 'ease'
  assign main_border_w = s.grl_main_border_width | default: 0
  assign main_border_c = s.grl_main_border_color | default: '#000000'
  assign sh_blur = s.grl_shadow_blur | default: 24
  assign sh_y = s.grl_shadow_y | default: 10
  assign sh_color = s.grl_shadow_color | default: '#000000'
  assign sh_op = s.grl_shadow_opacity | default: 0

  assign thumb_radius = s.grl_thumb_radius | default: 10
  assign t_pad = s.grl_thumb_strip_padding | default: 4
  assign t_border = s.grl_thumb_border | default: 1
  assign t_border_op = s.grl_thumb_border_opacity | default: 30
  assign t_active_c = s.grl_thumb_active_color | default: '#111111'
  assign t_active_w = s.grl_thumb_active_width | default: 2
  assign t_active_scale = s.grl_thumb_active_scale | default: 104
  assign t_shadow_op = s.grl_thumb_shadow_opacity | default: 6

  assign chev_on = s.grl_chevron_enable | default: true
  assign chev_style = s.grl_chevron_style | default: 'chevron'
  assign chev_size = s.grl_chevron_size | default: 42
  assign chev_stroke = s.grl_chevron_stroke | default: 2
  assign chev_icon = s.grl_chevron_icon_color | default: '#111111'
  assign chev_bg = s.grl_chevron_bg | default: '#ffffff'
  assign chev_bg_op = s.grl_chevron_bg_opacity | default: 72
  assign chev_blur = s.grl_chevron_blur | default: 8
  assign chev_sh_blur = s.grl_chevron_shadow_blur | default: 14
  assign chev_sh_color = s.grl_chevron_shadow_color | default: '#000000'
  assign chev_sh_op = s.grl_chevron_shadow_opacity | default: 12

  # ---------- pager: desktop/tablet (shared) ----------
  assign pg_size = s.grl_pager_size | default: 13
  assign pg_color = s.grl_pager_color | default: '#111111'
  assign pg_bg = s.grl_pager_bg | default: '#ffffff'
  assign pg_bg_op = s.grl_pager_bg_opacity | default: 80
  assign pg_blur = s.grl_pager_blur | default: 10
  assign pg_radius = s.grl_pager_radius | default: 20
  assign pg_offset = s.grl_pager_offset | default: 14

  # ---------- pager: mobile ----------
  assign pm_style = s.grl_pm_style | default: 'pill'
  assign pm_place = s.grl_pm_placement | default: 'below'
  assign pm_size = s.grl_pm_size | default: 11
  assign pm_offset = s.grl_pm_offset | default: 10
  assign pm_gap = s.grl_pm_gap | default: 7
  assign pm_color = s.grl_pm_color | default: '#111111'
  assign pm_bg = s.grl_pm_bg | default: '#ffffff'
  assign pm_bg_op = s.grl_pm_bg_opacity | default: 0
  assign pm_blur = s.grl_pm_blur | default: 0
  assign pm_radius = s.grl_pm_radius | default: 20
  assign pm_dot_size = s.grl_pm_dot_size | default: 6
  assign pm_dot_color = s.grl_pm_dot_color | default: '#cfcfcf'
  assign pm_dot_active = s.grl_pm_dot_active | default: '#111111'

  assign sh_a = sh_op | divided_by: 100.0
  assign t_border_a = t_border_op | divided_by: 100.0
  assign t_shadow_a = t_shadow_op | divided_by: 100.0
  assign chev_bg_a = chev_bg_op | divided_by: 100.0
  assign chev_sh_a = chev_sh_op | divided_by: 100.0
  assign pg_bg_a = pg_bg_op | divided_by: 100.0
  assign pm_bg_a = pm_bg_op | divided_by: 100.0

  assign pg_bg_v = pg_bg | color_modify: 'alpha', pg_bg_a
  assign pm_bg_v = pm_bg | color_modify: 'alpha', pm_bg_a
  assign pg_shadow = 'none'
  if pg_bg_op > 0
    assign pg_shadow = '0 2px 12px rgba(0,0,0,.12)'
  endif
  assign pm_shadow = 'none'
  if pm_bg_op > 0
    assign pm_shadow = '0 2px 12px rgba(0,0,0,.12)'
  endif

  assign d_root = 'row'
  if d_pos == 'right'
    assign d_root = 'row-reverse'
  elsif d_pos == 'bottom'
    assign d_root = 'column-reverse'
  endif
  assign t_root = 'row'
  if t_pos == 'right'
    assign t_root = 'row-reverse'
  elsif t_pos == 'bottom'
    assign t_root = 'column-reverse'
  endif
  assign m_root = 'row'
  if m_pos == 'right'
    assign m_root = 'row-reverse'
  elsif m_pos == 'bottom'
    assign m_root = 'column-reverse'
  endif

  assign d_maxh_v = 'none'
  if d_maxh > 0
    assign d_maxh_v = d_maxh | append: 'px'
  endif
  assign d_maxw_v = 'none'
  if d_maxw > 0
    assign d_maxw_v = d_maxw | append: 'px'
  endif
  assign d_minh_v = '0'
  if d_minh > 0
    assign d_minh_v = d_minh | append: 'px'
  endif
  assign d_scale_v = d_scale | divided_by: 100.0

  assign t_maxh_v = 'none'
  if t_maxh > 0
    assign t_maxh_v = t_maxh | append: 'px'
  endif

  assign m_maxh_v = 'none'
  if m_maxh > 0
    assign m_maxh_v = m_maxh | append: 'px'
  endif
  assign m_maxw_v = 'none'
  if m_maxw > 0
    assign m_maxw_v = m_maxw | append: 'px'
  endif
  assign m_minh_v = '0'
  if m_minh > 0
    assign m_minh_v = m_minh | append: 'px'
  endif
  assign m_scale_v = m_scale | divided_by: 100.0

  assign image_media = product.media | where: 'media_type', 'image'
-%}

<style>
  /* ---------- base structure ---------- */
  #{{ gid }} { display:flex; gap: var(--grl-gap); width:100%; box-sizing:border-box;
    flex-direction: var(--grl-root-dir); align-items:stretch;
    padding: var(--grl-pt) var(--grl-pr) var(--grl-pb) var(--grl-pl);
    max-width: var(--grl-max-w); min-height: var(--grl-min-h);
    transform: scale(var(--grl-scale)); transform-origin: top left;
    -webkit-user-select:none; user-select:none; -webkit-touch-callout:none; }

  #{{ gid }} .grl-mg__thumbcol { flex-shrink:0; position:relative; }
  #{{ gid }} .grl-mg__thumbs { display:flex; gap: var(--grl-thumb-gap); padding: {{ t_pad }}px; box-sizing:border-box;
    -ms-overflow-style:none; scrollbar-width:none; }
  #{{ gid }} .grl-mg__thumbs::-webkit-scrollbar { display:none; }
  #{{ gid }} .grl-mg__thumb { flex-shrink:0; width: var(--grl-thumb-w); aspect-ratio: var(--grl-thumb-aspect);
    border-radius: {{ thumb_radius }}px; overflow:hidden; cursor:pointer; position:relative; padding:0; border:0; background:transparent;
    box-shadow: 0 1px 5px rgba(0,0,0,{{ t_shadow_a }});
    transition: transform .25s cubic-bezier(.22,1,.36,1), box-shadow .25s ease; }
  #{{ gid }} .grl-mg__thumb::before { content:''; position:absolute; inset:0; z-index:1; pointer-events:none;
    border-radius:inherit; box-shadow: inset 0 0 0 {{ t_border }}px rgba(255,255,255,{{ t_border_a }}); }
  #{{ gid }} .grl-mg__thumb img { width:100%; height:100%; object-fit:cover; display:block; -webkit-user-drag:none; user-select:none; }
  #{{ gid }} .grl-mg__thumb--active { transform: scale({{ t_active_scale | divided_by: 100.0 }});
    box-shadow: inset 0 0 0 {{ t_active_w }}px {{ t_active_c }}, 0 3px 12px rgba(0,0,0,.14); }

  /* main column (stage + pager) */
  #{{ gid }} .grl-mg__main { flex:1; min-width:0; position:relative; display:flex; flex-direction:column; }

  /* stage */
  #{{ gid }} .grl-mg__stage { position:relative; overflow:hidden; width:100%;
    border-radius: var(--grl-main-radius); aspect-ratio: var(--grl-aspect); max-height: var(--grl-max-h);
    background: var(--grl-main-bg); -webkit-user-select:none; user-select:none;
    {% if main_border_w > 0 %}border: {{ main_border_w }}px solid {{ main_border_c }};{% endif %}
    {% if sh_op > 0 %}box-shadow: 0 {{ sh_y }}px {{ sh_blur }}px {{ sh_color | color_modify: 'alpha', sh_a }};{% endif %} }
  #{{ gid }} .grl-mg__slide { position:absolute; inset:0; width:100%; height:100%; opacity:0;
    transition: opacity {{ fade_ms }}ms {{ fade_ease }}; pointer-events:none; display:flex; align-items:center; justify-content:center; }
  #{{ gid }} .grl-mg__slide img, #{{ gid }} .grl-mg__slide video, #{{ gid }} .grl-mg__slide iframe {
    width:100% !important; height:100% !important; max-width:none !important; max-height:none !important;
    object-fit: var(--grl-fit) !important; object-position:center center !important; display:block; -webkit-user-drag:none; }
  #{{ gid }} .grl-mg__slide--active { opacity:1; z-index:1; }

  /* chevron cursor (desktop) */
  #{{ gid }} .grl-mg__chev { position:absolute; z-index:5; top:0; left:0; width:{{ chev_size }}px; height:{{ chev_size }}px;
    margin:-{{ chev_size | divided_by: 2 }}px 0 0 -{{ chev_size | divided_by: 2 }}px; pointer-events:none; opacity:0;
    display:flex; align-items:center; justify-content:center; border-radius:50%;
    background: {{ chev_bg | color_modify: 'alpha', chev_bg_a }};
    {% if chev_blur > 0 %}backdrop-filter: blur({{ chev_blur }}px); -webkit-backdrop-filter: blur({{ chev_blur }}px);{% endif %}
    box-shadow: 0 2px {{ chev_sh_blur }}px {{ chev_sh_color | color_modify: 'alpha', chev_sh_a }};
    transition: opacity .22s ease, transform .14s cubic-bezier(.22,1,.36,1); will-change:transform; }
  #{{ gid }} .grl-mg__chev--on { opacity:1; }
  #{{ gid }} .grl-mg__chev svg { width:48%; height:48%; stroke:{{ chev_icon }}; stroke-width:{{ chev_stroke }};
    fill:{% if chev_style == 'triangle' %}{{ chev_icon }}{% else %}none{% endif %}; stroke-linecap:round; stroke-linejoin:round;
    transition: transform .18s ease; }
  #{{ gid }} .grl-mg__chev--left svg { transform: rotate(180deg); }

  /* pager  ‹ 1 / 3 › — desktop/tablet defaults (overlay on stage) */
  #{{ gid }} .grl-mg__pager { --pg-size:{{ pg_size }}px; --pg-color:{{ pg_color }}; --pg-bg:{{ pg_bg_v }};
    --pg-blur:{{ pg_blur }}px; --pg-radius:{{ pg_radius }}px; --pg-gap:6px; --pg-shadow:{{ pg_shadow }};
    --pg-dot-size:6px; --pg-dot-color:#cfcfcf; --pg-dot-active:#111111;
    position:absolute; left:50%; bottom:{{ pg_offset }}px; transform:translateX(-50%); z-index:4;
    display:none; align-items:center; gap:var(--pg-gap); padding:5px 8px; border-radius:var(--pg-radius);
    background:var(--pg-bg); box-shadow:var(--pg-shadow); backdrop-filter:blur(var(--pg-blur));
    -webkit-backdrop-filter:blur(var(--pg-blur)); -webkit-user-select:none; user-select:none;
    font-size:var(--pg-size); line-height:1; color:var(--pg-color); font-family:inherit; font-variant-numeric:tabular-nums; }
  #{{ gid }} .grl-mg__pager--hidden { display:none !important; }
  #{{ gid }} .grl-mg__pg-btn { display:flex; align-items:center; justify-content:center;
    width:calc(var(--pg-size) + 9px); height:calc(var(--pg-size) + 9px); padding:0; margin:0; border:0; background:transparent;
    cursor:pointer; border-radius:50%; color:var(--pg-color); -webkit-tap-highlight-color:transparent;
    transition:opacity .15s ease, transform .15s ease; }
  #{{ gid }} .grl-mg__pg-btn:active { transform:scale(.86); }
  #{{ gid }} .grl-mg__pg-btn svg { width:calc(var(--pg-size) + 2px); height:calc(var(--pg-size) + 2px); stroke:currentColor;
    stroke-width:2.2; fill:none; stroke-linecap:round; stroke-linejoin:round; }
  #{{ gid }} .grl-mg__pg-count { min-width:30px; text-align:center; font-weight:600; letter-spacing:.3px; }
  #{{ gid }} .grl-mg__pg-count em { font-style:normal; opacity:.5; margin:0 2px; }
  #{{ gid }} .grl-mg__dots { display:none; align-items:center; gap:var(--pg-gap); }
  #{{ gid }} .grl-mg__dot { width:var(--pg-dot-size); height:var(--pg-dot-size); border-radius:50%; padding:0; margin:0; border:0;
    background:var(--pg-dot-color); cursor:pointer; -webkit-tap-highlight-color:transparent;
    transition:transform .2s ease, background .2s ease; }
  #{{ gid }} .grl-mg__dot--active { background:var(--pg-dot-active); transform:scale(1.35); }

  /* ---------- DESKTOP (base) ---------- */
  #{{ gid }} {
    --grl-root-dir: {{ d_root }};
    --grl-gap: {{ d_gap }}px; --grl-thumb-w: {{ d_thumb_w }}px; --grl-thumb-gap: {{ d_thumb_gap }}px;
    --grl-thumb-aspect: {{ d_thumb_aspect }}; --grl-thumb-valign: {{ d_valign }};
    --grl-aspect: {{ d_aspect }}; --grl-fit: {{ d_fit }}; --grl-main-radius: {{ d_radius }}px;
    --grl-main-bg: {{ d_bg }}; --grl-max-h: {{ d_maxh_v }};
    --grl-max-w: {{ d_maxw_v }}; --grl-min-h: {{ d_minh_v }}; --grl-scale: {{ d_scale_v }};
    --grl-pt: {{ d_pt }}px; --grl-pb: {{ d_pb }}px; --grl-pl: {{ d_pl }}px; --grl-pr: {{ d_pr }}px; }
  #{{ gid }} .grl-mg__thumbcol { display:{% if d_nav == 'thumbs' %}block{% else %}none{% endif %};
    {% if d_pos == 'bottom' %}width:100%;{% else %}width:calc(var(--grl-thumb-w) + {{ t_pad | times: 2 }}px);{% endif %} }
  #{{ gid }} .grl-mg__thumbs {
    {% if d_pos == 'bottom' %}flex-direction:row; position:static; inset:auto; width:100%; overflow-x:auto; overflow-y:hidden; justify-content:safe center;{% else %}flex-direction:column; position:absolute; inset:0; overflow-y:auto; overflow-x:hidden; justify-content:safe {{ d_valign }};{% endif %} }
  #{{ gid }} .grl-mg__pager { display:{% if d_nav == 'pager' %}flex{% else %}none{% endif %}; }
  #{{ gid }} .grl-mg__stage { cursor:{% if chev_on %}none{% else %}default{% endif %}; }

  /* ---------- TABLET ---------- */
  @media (min-width:750px) and (max-width:1199px) {
    #{{ gid }} {
      --grl-root-dir: {{ t_root }};
      --grl-gap: {{ t_gap }}px; --grl-thumb-w: {{ t_thumb_w }}px; --grl-thumb-gap: {{ t_thumb_gap }}px;
      --grl-thumb-aspect: {{ t_thumb_aspect }}; --grl-thumb-valign: {{ t_valign }};
      --grl-aspect: {{ t_aspect }}; --grl-fit: {{ t_fit }}; --grl-main-radius: {{ t_radius }}px;
      --grl-main-bg: {{ t_bg }}; --grl-max-h: {{ t_maxh_v }};
      --grl-max-w: none; --grl-min-h: 0; --grl-scale: 1;
      --grl-pt: {{ t_pt }}px; --grl-pb: {{ t_pb }}px; --grl-pl: {{ t_pl }}px; --grl-pr: {{ t_pr }}px; }
    #{{ gid }} .grl-mg__thumbcol { display:{% if t_nav == 'thumbs' %}block{% else %}none{% endif %};
      {% if t_pos == 'bottom' %}width:100%;{% else %}width:calc(var(--grl-thumb-w) + {{ t_pad | times: 2 }}px);{% endif %} }
    #{{ gid }} .grl-mg__thumbs {
      {% if t_pos == 'bottom' %}flex-direction:row; position:static; inset:auto; width:100%; overflow-x:auto; overflow-y:hidden; justify-content:safe center;{% else %}flex-direction:column; position:absolute; inset:0; overflow-y:auto; overflow-x:hidden; justify-content:safe {{ t_valign }};{% endif %} }
    #{{ gid }} .grl-mg__pager { display:{% if t_nav == 'pager' %}flex{% else %}none{% endif %}; }
    #{{ gid }} .grl-mg__stage { cursor:{% if chev_on %}none{% else %}default{% endif %}; }
  }

  /* ---------- MOBILE ---------- */
  @media (max-width:749px) {
    #{{ gid }} {
      --grl-root-dir: {{ m_root }};
      --grl-gap: {{ m_gap }}px; --grl-thumb-w: {{ m_thumb_w }}px; --grl-thumb-gap: {{ m_thumb_gap }}px;
      --grl-thumb-aspect: {{ m_thumb_aspect }}; --grl-thumb-valign: {{ m_valign }};
      --grl-aspect: {{ m_aspect }}; --grl-fit: {{ m_fit }}; --grl-main-radius: {{ m_radius }}px;
      --grl-main-bg: {{ m_bg }}; --grl-max-h: {{ m_maxh_v }};
      --grl-max-w: {{ m_maxw_v }}; --grl-min-h: {{ m_minh_v }}; --grl-scale: {{ m_scale_v }};
      --grl-pt: {{ m_pt }}px; --grl-pb: {{ m_pb }}px; --grl-pl: {{ m_pl }}px; --grl-pr: {{ m_pr }}px; }
    #{{ gid }} .grl-mg__thumbcol { display:{% if m_nav == 'thumbs' %}block{% else %}none{% endif %};
      {% if m_pos == 'bottom' %}width:100%;{% else %}width:calc(var(--grl-thumb-w) + {{ t_pad | times: 2 }}px);{% endif %} }
    #{{ gid }} .grl-mg__thumbs {
      {% if m_pos == 'bottom' %}flex-direction:row; position:static; inset:auto; width:100%; overflow-x:auto; overflow-y:hidden; justify-content:safe center;{% else %}flex-direction:column; position:absolute; inset:0; overflow-y:auto; overflow-x:hidden; justify-content:safe {{ m_valign }};{% endif %} }
    #{{ gid }} .grl-mg__stage { cursor:default; }
    #{{ gid }} .grl-mg__chev { display:none; }

    /* mobile pager overrides */
    #{{ gid }} .grl-mg__pager {
      --pg-size:{{ pm_size }}px; --pg-color:{{ pm_color }}; --pg-bg:{{ pm_bg_v }}; --pg-blur:{{ pm_blur }}px;
      --pg-radius:{{ pm_radius }}px; --pg-gap:{{ pm_gap }}px; --pg-shadow:{{ pm_shadow }};
      --pg-dot-size:{{ pm_dot_size }}px; --pg-dot-color:{{ pm_dot_color }}; --pg-dot-active:{{ pm_dot_active }};
      display:{% if m_nav == 'pager' %}flex{% else %}none{% endif %};
      padding:{% if pm_bg_op > 0 %}4px 8px{% else %}0{% endif %};
      {% if pm_place == 'below' %}position:static; transform:none; left:auto; bottom:auto; margin:{{ pm_offset }}px auto 0; align-self:center;{% else %}position:absolute; left:50%; bottom:{{ pm_offset }}px; transform:translateX(-50%); margin:0;{% endif %} }
    /* style: count only — hide arrows */
    #{{ gid }} .grl-mg__pager--m-count .grl-mg__pg-btn { display:none; }
    /* style: dots — hide arrows + count, show dots, drop pill bg */
    #{{ gid }} .grl-mg__pager--m-dots .grl-mg__pg-btn,
    #{{ gid }} .grl-mg__pager--m-dots .grl-mg__pg-count { display:none; }
    #{{ gid }} .grl-mg__pager--m-dots .grl-mg__dots { display:flex; }
    #{{ gid }} .grl-mg__pager--m-dots { background:transparent; box-shadow:none; backdrop-filter:none; -webkit-backdrop-filter:none; padding:0; }
  }
</style>

<div id="{{ gid }}" data-grl-mg ondragstart="return false;">
  {%- if image_media.size > 1 -%}
  <div class="grl-mg__thumbcol">
    <div class="grl-mg__thumbs" data-grl-thumbs>
      {%- for media in image_media -%}
        <button type="button" class="grl-mg__thumb{% if forloop.first %} grl-mg__thumb--active{% endif %}" data-grl-thumb data-grl-mid="{{ media.id }}" aria-label="View image {{ forloop.index }}">
          <img src="{{ media | image_url: width: 160 }}" alt="{{ media.alt | escape }}" loading="lazy" width="80" height="94" draggable="false">
        </button>
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}

  <div class="grl-mg__main">
    <div class="grl-mg__stage" data-grl-stage>
      {%- for media in product.media -%}
        <div class="grl-mg__slide{% if forloop.first %} grl-mg__slide--active{% endif %}" data-grl-slide data-grl-mid="{{ media.id }}">
          {%- if media.media_type == 'image' -%}
            {%- if forloop.first -%}{%- assign ld = 'eager' -%}{%- else -%}{%- assign ld = 'lazy' -%}{%- endif -%}
            <img src="{{ media | image_url: width: 1200 }}"
              srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1600 }} 1600w"
              sizes="(max-width:749px) 100vw, 50vw" alt="{{ media.alt | escape }}" loading="{{ ld }}" width="{{ media.width }}" height="{{ media.height }}" draggable="false">
          {%- else -%}
            {{ media | media_tag: image_size: '1200x' }}
          {%- endif -%}
        </div>
      {%- endfor -%}

      {%- if chev_on -%}
        <div class="grl-mg__chev" data-grl-chev>
          {%- case chev_style -%}
            {%- when 'arrow' -%}<svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="18" y2="12"></line><polyline points="12 6 18 12 12 18"></polyline></svg>
            {%- when 'triangle' -%}<svg viewBox="0 0 24 24"><polygon points="8 5 18 12 8 19"></polygon></svg>
            {%- when 'caret' -%}<svg viewBox="0 0 24 24"><polyline points="10 7 15 12 10 17"></polyline></svg>
            {%- when 'chevron-thin' -%}<svg viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"></polyline></svg>
            {%- else -%}<svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg>
          {%- endcase -%}
        </div>
      {%- endif -%}
    </div>

    <div class="grl-mg__pager grl-mg__pager--m-{{ pm_style }}" data-grl-pager>
      <button type="button" class="grl-mg__pg-btn" data-grl-prev aria-label="Previous image"><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg></button>
      <span class="grl-mg__pg-count"><span data-grl-cur>1</span><em>/</em><span data-grl-tot>1</span></span>
      <button type="button" class="grl-mg__pg-btn" data-grl-next aria-label="Next image"><svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg></button>
      <span class="grl-mg__dots" data-grl-dots></span>
    </div>
  </div>
</div>

<script>
(function(){
  var root = document.getElementById('{{ gid }}');
  if(!root || root.__grlInit) return; root.__grlInit = true;
  window.__grlGal = true; // disable the standalone variant-filter snippet
  var stage = root.querySelector('[data-grl-stage]');
  var thumbsWrap = root.querySelector('[data-grl-thumbs]');
  var chev = root.querySelector('[data-grl-chev]');
  var pager = root.querySelector('[data-grl-pager]');
  var pgCur = root.querySelector('[data-grl-cur]');
  var pgTot = root.querySelector('[data-grl-tot]');
  var dotsWrap = root.querySelector('[data-grl-dots]');
  var allSlides = Array.prototype.slice.call(root.querySelectorAll('[data-grl-slide]'));
  var allThumbs = thumbsWrap ? Array.prototype.slice.call(thumbsWrap.querySelectorAll('[data-grl-thumb]')) : [];
  var MID = 'data-grl-mid';

  // ---- Variant segment data ----
  var MEDIA_ORDER = [{% for m in product.media %}"{{ m.id }}"{% unless forloop.last %},{% endunless %}{% endfor %}];
  var INIT_TITLE = {{ product.selected_or_first_available_variant.title | json }};
  var VARIANTS = [
    {% for v in product.variants -%}
    { title: {{ v.title | json }}, media: {% if v.featured_media %}"{{ v.featured_media.id }}"{% else %}null{% endif %} }{% unless forloop.last %},{% endunless %}
    {% endfor -%}
  ];
  var norm = function(x){ return (x==null?'':String(x)).trim().toLowerCase(); };
  var marks = [];
  VARIANTS.forEach(function(v){ if(!v.media) return; var i=MEDIA_ORDER.indexOf(v.media); if(i<0) return; marks.push({t:v.title,start:i}); });
  marks.sort(function(a,b){ return a.start-b.start; });
  if(marks.length) marks[0].start = 0;
  var SEG = {};
  marks.forEach(function(m,i){
    var end = (i+1<marks.length) ? marks[i+1].start : MEDIA_ORDER.length;
    var set = {}; MEDIA_ORDER.slice(m.start,end).forEach(function(x){ set[x]=1; });
    SEG[norm(m.t)] = set;
  });

  // ---- State ----
  var curKey = null;
  var curSet = null;
  var visSlides = allSlides;
  var visThumbs = allThumbs;
  var idx = 0;
  var isMobile = window.matchMedia('(max-width:749px)').matches;

  function buildDots(){
    if(!dotsWrap) return;
    if(dotsWrap.children.length === visSlides.length) return;
    dotsWrap.innerHTML = '';
    for(var i=0;i<visSlides.length;i++){
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'grl-mg__dot'; b.setAttribute('data-grl-dot', i);
      b.setAttribute('aria-label', 'Go to image ' + (i+1));
      dotsWrap.appendChild(b);
    }
  }

  function rebuildVisible(){
    if(!curSet){ visSlides = allSlides.slice(); visThumbs = allThumbs.slice(); }
    else {
      visSlides = allSlides.filter(function(el){ return curSet[el.getAttribute(MID)]; });
      visThumbs = allThumbs.filter(function(el){ return curSet[el.getAttribute(MID)]; });
    }
    allSlides.forEach(function(el){ el.style.display = (curSet && !curSet[el.getAttribute(MID)]) ? 'none' : ''; });
    allThumbs.forEach(function(el){ el.style.display = (curSet && !curSet[el.getAttribute(MID)]) ? 'none' : ''; });
    buildDots();
    if(pager) pager.classList.toggle('grl-mg__pager--hidden', visSlides.length < 2);
  }

  function show(i){
    if(!visSlides.length) return;
    if(i < 0) i = visSlides.length - 1;
    if(i >= visSlides.length) i = 0;
    idx = i;
    visSlides.forEach(function(el,j){ el.classList.toggle('grl-mg__slide--active', j===i); });
    visThumbs.forEach(function(el,j){ el.classList.toggle('grl-mg__thumb--active', j===i); });
    if(pgCur) pgCur.textContent = (i+1);
    if(pgTot) pgTot.textContent = visSlides.length;
    if(dotsWrap){ var dts = dotsWrap.children; for(var k=0;k<dts.length;k++){ dts[k].classList.toggle('grl-mg__dot--active', k===i); } }
    var at = visThumbs[i];
    if(at && at.scrollIntoView) at.scrollIntoView({ block:'nearest', inline:'nearest', behavior:'smooth' });
  }

  function setVariant(title){
    var key = norm(title);
    if(key === curKey) return;
    if(!SEG[key]) return;            // unknown variant — keep current view, don't reset to all
    curKey = key;
    curSet = SEG[key];
    rebuildVisible();
    show(0);
  }

  // ---- Thumbnail clicks ----
  if(thumbsWrap){
    thumbsWrap.addEventListener('click', function(e){
      var t = e.target.closest('[data-grl-thumb]'); if(!t) return;
      var id = t.getAttribute(MID);
      for(var j=0;j<visSlides.length;j++){ if(visSlides[j].getAttribute(MID)===id){ show(j); break; } }
    });
  }

  // ---- Pager (arrows + dots) ----
  if(pager){
    var prev = pager.querySelector('[data-grl-prev]');
    var next = pager.querySelector('[data-grl-next]');
    if(prev) prev.addEventListener('click', function(e){ e.stopPropagation(); show(idx-1); });
    if(next) next.addEventListener('click', function(e){ e.stopPropagation(); show(idx+1); });
    if(dotsWrap) dotsWrap.addEventListener('click', function(e){
      var d = e.target.closest('[data-grl-dot]'); if(!d) return;
      e.stopPropagation(); show(parseInt(d.getAttribute('data-grl-dot'),10) || 0);
    });
  }

  // ---- Chevron cursor + click nav ----
  if(chev){
    var raf=null, cx=0, cy=0, side=null, active=false;
    function paint(){ chev.style.transform = 'translate('+cx+'px,'+cy+'px)'; if(active) raf=requestAnimationFrame(paint); }
    stage.addEventListener('mouseenter', function(){ if(isMobile) return; chev.classList.add('grl-mg__chev--on'); active=true; paint(); });
    stage.addEventListener('mouseleave', function(){ chev.classList.remove('grl-mg__chev--on'); active=false; side=null; if(raf) cancelAnimationFrame(raf); });
    stage.addEventListener('mousemove', function(e){
      if(isMobile) return;
      var r = stage.getBoundingClientRect();
      cx = e.clientX - r.left; cy = e.clientY - r.top;
      var ns = (cx < r.width/2) ? 'left' : 'right';
      if(ns !== side){ side = ns; chev.classList.toggle('grl-mg__chev--left', ns==='left'); }
    });
  }
  stage.addEventListener('click', function(e){
    if(isMobile || visSlides.length < 2) return;
    var r = stage.getBoundingClientRect();
    if((e.clientX - r.left) < r.width/2) show(idx-1); else show(idx+1);
  });
  stage.addEventListener('dblclick', function(e){ e.preventDefault(); });
  stage.addEventListener('selectstart', function(e){ e.preventDefault(); });
  stage.addEventListener('mousedown', function(e){ if(e.detail > 1) e.preventDefault(); });

  // ---- Mobile swipe ----
  var tsx=0, tsy=0;
  stage.addEventListener('touchstart', function(e){ tsx = e.touches[0].clientX; tsy = e.touches[0].clientY; }, {passive:true});
  stage.addEventListener('touchend', function(e){
    var dx = e.changedTouches[0].clientX - tsx;
    var dy = e.changedTouches[0].clientY - tsy;
    if(Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy) || visSlides.length < 2) return;
    if(dx < 0) show(idx+1); else show(idx-1);
  }, {passive:true});

  // ---- Variant picker wiring ----
  function syncVariant(){ var c = document.querySelector('input[name="grl_type"]:checked'); if(c) setVariant(c.value); }
  document.addEventListener('change', function(e){ if(e.target && e.target.name==='grl_type') setTimeout(syncVariant, 20); }, true);
  document.addEventListener('click', function(e){
    var l = e.target && e.target.closest && e.target.closest('label.grl-variant-label');
    if(l){ var inp = l.querySelector('input[name="grl_type"]'); if(inp) setTimeout(function(){ setVariant(inp.value); }, 30); }
  }, true);
  window.matchMedia('(max-width:749px)').addEventListener('change', function(e){ isMobile = e.matches; });

  // ---- Init: filter to the selected variant immediately, then keep syncing ----
  if(INIT_TITLE && SEG[norm(INIT_TITLE)]) { setVariant(INIT_TITLE); }
  else { rebuildVisible(); show(0); }
  syncVariant();
  [50,150,400,900].forEach(function(d){ setTimeout(syncVariant, d); });
})();
</script>
