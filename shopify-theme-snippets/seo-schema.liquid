{% comment %}
  GRL® SEO Schema Markup (JSON-LD)
  ────────────────────────────────
  Add this snippet to theme.liquid, right before </head>:
  {% render 'seo-schema' %}
{% endcomment %}

{% comment %} ═══ ORGANIZATION SCHEMA (All Pages) ═══ {% endcomment %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "GRL®",
  "alternateName": "GRLHOOD",
  "url": "https://www.grlhood.in",
  "logo": "https://www.grlhood.in/cdn/shop/files/GIRLHOOD_WHITE_PNG_ad6f6e58-68b1-4497-89b5-5414df0507b3.png",
  "description": "Stand out from the crowd with unique daily essentials from GRL®. Phone cases turned fashion accessories. Aesthetic, protective, and anything but basic.",
  "foundingDate": "2024",
  "sameAs": [
    "https://www.instagram.com/grlhood.in"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    "availableLanguage": ["English", "Hindi"]
  },
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "IN"
  }
}
</script>

{% comment %} ═══ WEBSITE SCHEMA WITH SEARCHACTION (Homepage Only) ═══ {% endcomment %}
{% if template == 'index' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "GRL®",
  "url": "https://www.grlhood.in",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://www.grlhood.in/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>
{% endif %}

{% comment %} ═══ BREADCRUMB SCHEMA (All Pages) ═══ {% endcomment %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.grlhood.in"
    }
    {% if template contains 'collection' %}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": "{{ collection.title | escape }}",
      "item": "{{ shop.url }}{{ collection.url }}"
    }
    {% endif %}
    {% if template contains 'product' %}
    {% if product.collections.size > 0 %}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": "{{ product.collections.first.title | escape }}",
      "item": "{{ shop.url }}{{ product.collections.first.url }}"
    }
    ,{
      "@type": "ListItem",
      "position": 3,
      "name": "{{ product.title | escape }}",
      "item": "{{ shop.url }}{{ product.url }}"
    }
    {% else %}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": "{{ product.title | escape }}",
      "item": "{{ shop.url }}{{ product.url }}"
    }
    {% endif %}
    {% endif %}
    {% if template contains 'article' %}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "{{ shop.url }}/blogs/{{ article.blog.handle }}"
    }
    ,{
      "@type": "ListItem",
      "position": 3,
      "name": "{{ article.title | escape }}",
      "item": "{{ shop.url }}{{ article.url }}"
    }
    {% endif %}
  ]
}
</script>

{% comment %} ═══ PRODUCT SCHEMA (Product Pages Only) ═══ {% endcomment %}
{% if template contains 'product' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "{{ product.title | escape }}",
  "description": "{{ product.description | strip_html | truncate: 500 | escape }}",
  "url": "{{ shop.url }}{{ product.url }}",
  "image": [
    {% for image in product.images limit: 5 %}
    "{{ image | image_url: width: 1200 }}"{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  "brand": {
    "@type": "Brand",
    "name": "GRL®"
  },
  "sku": "{{ product.selected_or_first_available_variant.sku | escape }}",
  "category": "Phone Cases",
  "offers": {
    "@type": "AggregateOffer",
    "url": "{{ shop.url }}{{ product.url }}",
    "priceCurrency": "INR",
    "lowPrice": "{{ product.price_min | money_without_currency | remove: ',' }}",
    "highPrice": "{{ product.price_max | money_without_currency | remove: ',' }}",
    "offerCount": "{{ product.variants.size }}",
    "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
    "seller": {
      "@type": "Organization",
      "name": "GRL®"
    },
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingDestination": {
        "@type": "DefinedRegion",
        "addressCountry": "IN"
      },
      "deliveryTime": {
        "@type": "ShippingDeliveryTime",
        "handlingTime": {
          "@type": "QuantitativeValue",
          "minValue": 1,
          "maxValue": 2,
          "unitCode": "d"
        },
        "transitTime": {
          "@type": "QuantitativeValue",
          "minValue": 3,
          "maxValue": 7,
          "unitCode": "d"
        }
      }
    }
  }
  {% if product.metafields.judgeme.badge %}
  ,"aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ product.metafields.judgeme.badge | split: 'data-average-rating="' | last | split: '"' | first }}",
    "reviewCount": "{{ product.metafields.judgeme.badge | split: 'data-number-of-reviews="' | last | split: '"' | first }}",
    "bestRating": "5",
    "worstRating": "1"
  }
  {% endif %}
}
</script>
{% endif %}

{% comment %} ═══ PRODUCT FAQ SCHEMA (Product Pages Only) ═══ {% endcomment %}
{% if template contains 'product' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What phone models does the {{ product.title | escape }} case fit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The {{ product.title | escape }} by GRL® is available in Armoured, Glass, and Slim Snap variants for iPhone and Samsung models including iPhone 12 through iPhone 17 Pro Max, and Samsung Galaxy S21 through S26 Ultra. Select your exact model at checkout."
      }
    },
    {
      "@type": "Question",
      "name": "How much does the {{ product.title | escape }} phone case cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The {{ product.title | escape }} starts at ₹{{ product.price_min | money_without_currency | remove: ',' }}{% if product.price_min != product.price_max %} and goes up to ₹{{ product.price_max | money_without_currency | remove: ',' }}{% endif %}. Free shipping across India on all orders."
      }
    },
    {
      "@type": "Question",
      "name": "Is the {{ product.title | escape }} case protective?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Every GRL® case is designed with raised edges for camera and screen protection, precise cutouts for all ports, and premium materials that resist scratches and drops. The Armoured variant offers maximum protection, Glass gives a premium feel, and Slim Snap is ultra-light."
      }
    },
    {
      "@type": "Question",
      "name": "Does GRL® offer free shipping in India?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, GRL® offers free shipping across India on all orders. Delivery typically takes 3-7 business days depending on your location."
      }
    },
    {
      "@type": "Question",
      "name": "What is the return policy for GRL® phone cases?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "GRL® offers easy returns and exchanges. If your case arrives damaged or doesn't meet expectations, contact our customer service team for a hassle-free resolution."
      }
    }
  ]
}
</script>
{% endif %}

{% comment %} ═══ COLLECTION SCHEMA (Collection Pages Only) ═══ {% endcomment %}
{% if template contains 'collection' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "{{ collection.title | escape }}",
  "description": "{{ collection.description | strip_html | truncate: 300 | escape }}",
  "url": "{{ shop.url }}{{ collection.url }}",
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": {{ collection.products_count }},
    "itemListElement": [
      {% for product in collection.products limit: 10 %}
      {
        "@type": "ListItem",
        "position": {{ forloop.index }},
        "url": "{{ shop.url }}{{ product.url }}",
        "name": "{{ product.title | escape }}"
      }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
}
</script>
{% endif %}

{% comment %} ═══ ARTICLE/BLOG SCHEMA (Blog Posts Only) ═══ {% endcomment %}
{% if template contains 'article' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ article.title | escape }}",
  "description": "{{ article.excerpt_or_content | strip_html | truncate: 300 | escape }}",
  "url": "{{ shop.url }}{{ article.url }}",
  "datePublished": "{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S+05:30' }}",
  "dateModified": "{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S+05:30' }}",
  "image": "{% if article.image %}{{ article.image | image_url: width: 1200 }}{% endif %}",
  "author": {
    "@type": "Person",
    "name": "{{ article.author | escape }}",
    "url": "https://www.grlhood.in"
  },
  "publisher": {
    "@type": "Organization",
    "name": "GRL®",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.grlhood.in/cdn/shop/files/GIRLHOOD_WHITE_PNG_ad6f6e58-68b1-4497-89b5-5414df0507b3.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ shop.url }}{{ article.url }}"
  }
}
</script>
{% endif %}

{% comment %} ═══ FAQ SCHEMA (Pages with FAQ content) ═══ {% endcomment %}
{% if template contains 'page' and page.content contains 'FAQ' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% assign faq_parts = page.content | split: '<h3>' %}
    {% for part in faq_parts offset: 1 %}
      {% assign question = part | split: '</h3>' | first | strip_html %}
      {% assign answer = part | split: '</h3>' | last | split: '<h3>' | first | split: '<h2>' | first | strip_html | strip %}
      {% if question != blank and answer != blank %}
      {% unless forloop.first == true and forloop.index > 1 %},{% endunless %}
      {
        "@type": "Question",
        "name": "{{ question | escape }}",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "{{ answer | escape }}"
        }
      }
      {% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}