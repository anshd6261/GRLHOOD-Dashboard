
{% render 'grl-media-gallery', block: block, product: closest.product %}

{% schema %}
{
  "name": "t:names.product_media",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "GRL Gallery — Desktop"
    },
    {
      "type": "select",
      "id": "grl_d_nav",
      "label": "Navigation",
      "options": [
        { "value": "thumbs", "label": "Thumbnails" },
        { "value": "pager", "label": "Pager (‹ 1/3 ›)" },
        { "value": "none", "label": "None" }
      ],
      "default": "thumbs"
    },
    {
      "type": "select",
      "id": "grl_d_pos",
      "label": "Thumbnail position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "grl_d_valign",
      "label": "Thumbnail vertical align (left/right)",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "grl_d_thumb_w",
      "label": "Thumbnail width",
      "min": 40, "max": 110, "step": 2, "unit": "px", "default": 64
    },
    {
      "type": "range",
      "id": "grl_d_thumb_gap",
      "label": "Spacing between thumbnails",
      "min": 2, "max": 24, "step": 2, "unit": "px", "default": 8
    },
    {
      "type": "select",
      "id": "grl_d_thumb_aspect",
      "label": "Thumbnail shape",
      "options": [
        { "value": "1/1.18", "label": "Portrait" },
        { "value": "1/1", "label": "Square" },
        { "value": "3/4", "label": "Portrait tall" }
      ],
      "default": "1/1.18"
    },
    {
      "type": "range",
      "id": "grl_d_gap",
      "label": "Gap: thumbnails ↔ image",
      "min": 0, "max": 48, "step": 2, "unit": "px", "default": 12
    },
    {
      "type": "select",
      "id": "grl_d_aspect",
      "label": "Image shape",
      "options": [
        { "value": "3/3.75", "label": "Portrait (3:3.75)" },
        { "value": "3/4", "label": "Portrait tall (3:4)" },
        { "value": "4/5", "label": "Portrait (4:5)" },
        { "value": "1/1", "label": "Square" },
        { "value": "4/3", "label": "Landscape" }
      ],
      "default": "3/3.75"
    },
    {
      "type": "select",
      "id": "grl_d_fit",
      "label": "Image fit",
      "options": [
        { "value": "contain", "label": "Contain (no crop)" },
        { "value": "cover", "label": "Cover (fill)" }
      ],
      "default": "contain"
    },
    {
      "type": "range",
      "id": "grl_d_radius",
      "label": "Image corner radius",
      "min": 0, "max": 48, "step": 2, "unit": "px", "default": 16
    },
    {
      "type": "color",
      "id": "grl_d_bg",
      "label": "Image background",
      "default": "#f4f4f4"
    },
    {
      "type": "range",
      "id": "grl_d_maxh",
      "label": "Max image height (0 = off)",
      "min": 0, "max": 900, "step": 20, "unit": "px", "default": 0
    },
    {
      "type": "range",
      "id": "grl_d_maxw",
      "label": "Max gallery width (0 = full)",
      "min": 0, "max": 1000, "step": 10, "unit": "px", "default": 0
    },
    {
      "type": "range",
      "id": "grl_d_minh",
      "label": "Min gallery height (0 = auto)",
      "min": 0, "max": 900, "step": 10, "unit": "px", "default": 0
    },
    {
      "type": "range",
      "id": "grl_d_scale",
      "label": "Overall scale / zoom",
      "min": 60, "max": 120, "step": 1, "unit": "%", "default": 100
    },
    {
      "type": "range",
      "id": "grl_d_pt",
      "label": "Padding top",
      "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0
    },
    {
      "type": "range",
      "id": "grl_d_pb",
