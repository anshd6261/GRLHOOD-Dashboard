{% comment %}
  GRL® SEO Enhancements
  ─────────────────────
  Supplements Shopify's default meta-tags snippet with:
  - og:locale for India targeting
  - Product price OG tags
  - Article timestamps
  - Twitter image tags (not in default snippet)
  - GA4 tracking

  Placed AFTER meta-tags in theme.liquid <head>.
  Title, canonical, meta description, and base OG tags are handled by
  Shopify's meta-tags snippet using SEO fields set via Admin API.
{% endcomment %}

{% comment %} ═══ SUPPLEMENTAL OG TAGS ═══ {% endcomment %}
<meta property="og:locale" content="en_IN">

{% if template contains 'product' %}
  {% if product.featured_image %}
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="1200">
  {% endif %}
  <meta property="product:price:amount" content="{{ product.price | money_without_currency }}">
  <meta property="product:price:currency" content="INR">
{% endif %}

{% if template contains 'article' %}
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S+05:30' }}">
  <meta property="article:author" content="{{ article.author }}">
{% endif %}

{% comment %} ═══ TWITTER IMAGE (not in default snippet) ═══ {% endcomment %}
{% if template == 'index' %}
  <meta name="twitter:image" content="https://www.grlhood.in/cdn/shop/files/GIRLHOOD_WHITE_PNG_ad6f6e58-68b1-4497-89b5-5414df0507b3.png">
{% elsif template contains 'product' and product.featured_image %}
  <meta name="twitter:image" content="{{ product.featured_image | image_url: width: 1200 }}">
{% elsif template contains 'article' and article.image %}
  <meta name="twitter:image" content="{{ article.image | image_url: width: 1200 }}">
{% endif %}

{% comment %} ═══ GA4 TRACKING ═══ {% endcomment %}
<!-- Google Analytics 4 -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-9427C33TGQ"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-9427C33TGQ');
</script>
