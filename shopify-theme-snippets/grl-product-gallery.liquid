{%- comment -%}
  GRL — Custom Product Media Gallery
  ------------------------------------------------------------------
  Replaces Horizon's built-in gallery with:
  • Vertical thumbnails on the left (variant-filtered)
  • Main image with fade-in/out transitions
  • Hovering chevron cursor that tracks mouse, changes direction L/R
  • Fully configurable via section settings
{%- endcomment -%}
{%- if request.page_type == 'product' and product.media.size > 0 -%}
{%- liquid
  assign gal_id = 'grl-gallery-' | append: product.id
  assign pt = section.settings.grl_gallery_padding_top | default: 0
  assign pb = section.settings.grl_gallery_padding_bottom | default: 0
  assign pl = section.settings.grl_gallery_padding_left | default: 0
  assign pr = section.settings.grl_gallery_padding_right | default: 0
  assign main_radius = section.settings.grl_gallery_main_radius | default: 16
  assign thumb_radius = section.settings.grl_gallery_thumb_radius | default: 10
  assign thumb_size = section.settings.grl_gallery_thumb_size | default: 64
  assign thumb_gap = section.settings.grl_gallery_thumb_gap | default: 8
  assign thumb_pad = section.settings.grl_gallery_thumb_padding | default: 6
  assign thumb_border_w = section.settings.grl_gallery_thumb_border | default: 1
  assign thumb_border_opacity = section.settings.grl_gallery_thumb_border_opacity | default: 25
  assign thumb_bg_opacity = section.settings.grl_gallery_thumb_bg_opacity | default: 10
  assign thumb_blur = section.settings.grl_gallery_thumb_blur | default: 12
  assign main_aspect = section.settings.grl_gallery_aspect | default: '3/3.75'
  assign main_max_height = section.settings.grl_gallery_max_height | default: 680
  assign fade_duration = section.settings.grl_gallery_fade_duration | default: 280
  assign chevron_size = section.settings.grl_gallery_chevron_size | default: 40
  assign gallery_gap = section.settings.grl_gallery_gap | default: 12
-%}

<style>
  /* ============ HIDE Horizon gallery ============ */
  media-gallery.media-gallery--carousel { display: none !important; }

  /* ============ GRL Gallery ============ */
  .grl-gal { display: flex; gap: {{ gallery_gap }}px; padding: {{ pt }}px {{ pr }}px {{ pb }}px {{ pl }}px; width: 100%; box-sizing: border-box; align-items: flex-start; }
  .grl-gal__thumbs { display: flex; flex-direction: column; gap: {{ thumb_gap }}px; flex-shrink: 0; overflow-y: auto; overflow-x: hidden; -ms-overflow-style: none; scrollbar-width: none; max-height: {{ main_max_height }}px; padding: {{ thumb_pad }}px; }
  .grl-gal__thumbs::-webkit-scrollbar { display: none; }
  .grl-gal__thumb { width: {{ thumb_size }}px; height: {{ thumb_size | times: 1.25 }}px; border-radius: {{ thumb_radius }}px; overflow: hidden; cursor: pointer; flex-shrink: 0; position: relative;
    background: rgba(255,255,255,{{ thumb_bg_opacity | divided_by: 100.0 }});
    border: {{ thumb_border_w }}px solid rgba(255,255,255,{{ thumb_border_opacity | divided_by: 100.0 }});
    backdrop-filter: blur({{ thumb_blur }}px); -webkit-backdrop-filter: blur({{ thumb_blur }}px);
    transition: border-color .25s ease, box-shadow .25s ease, transform .25s ease;
    box-shadow: 0 1px 4px rgba(0,0,0,.06);
  }
  .grl-gal__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; }
  .grl-gal__thumb--active { border-color: rgba(0,0,0,.35); box-shadow: 0 2px 10px rgba(0,0,0,.12); transform: scale(1.04); }

  .grl-gal__main { flex: 1; min-width: 0; position: relative; border-radius: {{ main_radius }}px; overflow: hidden; aspect-ratio: {{ main_aspect }}; max-height: {{ main_max_height }}px; cursor: none; background: #f5f5f5; }
  .grl-gal__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity {{ fade_duration }}ms ease; pointer-events: none; }
  .grl-gal__img--active { opacity: 1; z-index: 1; }

  /* ============ Hovering chevron cursor ============ */
  .grl-gal__chevron { position: absolute; z-index: 10; pointer-events: none; width: {{ chevron_size }}px; height: {{ chevron_size }}px; opacity: 0; transition: opacity .22s ease, transform .18s ease;
    display: flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,.7); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border-radius: 50%; box-shadow: 0 2px 12px rgba(0,0,0,.10);
  }
  .grl-gal__chevron--visible { opacity: 1; }
  .grl-gal__chevron svg { width: 50%; height: 50%; stroke: #111; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .grl-gal__chevron--left svg { transform: rotate(180deg); }

  /* ============ Mobile ============ */
  @media (max-width: 749px) {
    .grl-gal { flex-direction: column-reverse; gap: 8px; padding: 0; }
    .grl-gal__thumbs { flex-direction: row; overflow-x: auto; overflow-y: hidden; max-height: none; width: 100%; padding: 4px 8px; }
    .grl-gal__thumb { width: {{ thumb_size | times: 0.85 | ceil }}px; height: {{ thumb_size | times: 1.05 | ceil }}px; }
    .grl-gal__main { max-height: none; aspect-ratio: 3/3.75; border-radius: {{ main_radius | times: 0.6 | ceil }}px; cursor: default; }
    .grl-gal__chevron { display: none; }
  }
</style>

<div class="grl-gal" id="{{ gal_id }}">
  {%- comment -%} Vertical thumbnails {%- endcomment -%}
  <div class="grl-gal__thumbs" data-grl-thumbs>
    {%- for media in product.media -%}
      {%- if media.media_type == 'image' -%}
        <div class="grl-gal__thumb{% if forloop.first %} grl-gal__thumb--active{% endif %}" data-grl-thumb data-media-id="{{ media.id }}" data-index="{{ forloop.index0 }}">
          <img src="{{ media | image_url: width: 180 }}" alt="{{ media.alt | escape }}" loading="lazy" width="90" height="112">
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- comment -%} Main image area {%- endcomment -%}
  <div class="grl-gal__main" data-grl-main>
    {%- for media in product.media -%}
      {%- if media.media_type == 'image' -%}
        {%- if forloop.first -%}
          {%- assign img_loading = 'eager' -%}
        {%- else -%}
          {%- assign img_loading = 'lazy' -%}
        {%- endif -%}
        <img class="grl-gal__img{% if forloop.first %} grl-gal__img--active{% endif %}" data-grl-img data-media-id="{{ media.id }}" data-index="{{ forloop.index0 }}"
          src="{{ media | image_url: width: 1200 }}"
          srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1600 }} 1600w"
          sizes="(max-width: 749px) 100vw, 55vw"
          alt="{{ media.alt | escape }}" loading="{{ img_loading }}" width="{{ media.width }}" height="{{ media.height }}">
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%} Hovering chevron {%- endcomment -%}
    <div class="grl-gal__chevron" data-grl-chevron>
      <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </div>
  </div>
</div>

<script>
(function(){
  var galEl = document.getElementById('{{ gal_id }}');
  if(!galEl || window.__grlGal) return; window.__grlGal = true;
  var mainEl = galEl.querySelector('[data-grl-main]');
  var thumbsEl = galEl.querySelector('[data-grl-thumbs]');
  var chevronEl = galEl.querySelector('[data-grl-chevron]');
  var allImgs = Array.from(mainEl.querySelectorAll('[data-grl-img]'));
  var allThumbs = Array.from(thumbsEl.querySelectorAll('[data-grl-thumb]'));

  // ---- Variant segment data (from server) ----
  var MEDIA_ORDER = [{% for m in product.media %}"{{ m.id }}"{% unless forloop.last %},{% endunless %}{% endfor %}];
  var VARIANTS = [
    {% for v in product.variants -%}
    { title: {{ v.title | json }}, media: {% if v.featured_media %}"{{ v.featured_media.id }}"{% else %}null{% endif %} }{% unless forloop.last %},{% endunless %}
    {% endfor -%}
  ];
  var norm = function(s){ return (s==null?'':String(s)).trim().toLowerCase(); };

  // Build segments
  var marks = [];
  VARIANTS.forEach(function(v){ if(!v.media)return; var i=MEDIA_ORDER.indexOf(v.media); if(i<0)return; marks.push({title:v.title,start:i}); });
  marks.sort(function(a,b){ return a.start-b.start; });
  if(marks.length) marks[0].start = 0;
  var SEG = {};
  marks.forEach(function(m,i){
    var end = (i+1<marks.length) ? marks[i+1].start : MEDIA_ORDER.length;
    var ids = MEDIA_ORDER.slice(m.start, end);
    var set = {}; ids.forEach(function(x){ set[x]=1; });
    SEG[norm(m.title)] = { ids: ids, set: set };
  });
  var ORDER = marks.map(function(m){ return norm(m.title); });

  // ---- State ----
  var visibleIds = null;  // null = show all
  var currentIdx = 0;     // index into visible subset
  var visibleImgs = allImgs;
  var visibleThumbs = allThumbs;
  var chevronSide = null; // 'left' | 'right' | null
  var isMobile = window.matchMedia('(max-width:749px)').matches;

  function getVisibleList(){
    if(!visibleIds) return { imgs: allImgs, thumbs: allThumbs };
    var imgs = allImgs.filter(function(el){ return !!visibleIds[el.getAttribute('data-media-id')]; });
    var thumbs = allThumbs.filter(function(el){ return !!visibleIds[el.getAttribute('data-media-id')]; });
    return { imgs: imgs, thumbs: thumbs };
  }

  function filterVariant(title){
    var key = norm(title);
    var seg = SEG[key];
    if(!seg){ visibleIds = null; } else { visibleIds = seg.set; }
    var v = getVisibleList();
    visibleImgs = v.imgs;
    visibleThumbs = v.thumbs;
    // hide/show thumbs and images per variant
    allThumbs.forEach(function(t){ t.style.display = visibleIds && !visibleIds[t.getAttribute('data-media-id')] ? 'none' : ''; });
    allImgs.forEach(function(im){ if(visibleIds && !visibleIds[im.getAttribute('data-media-id')]){ im.classList.remove('grl-gal__img--active'); im.style.display='none'; } else { im.style.display=''; } });
    currentIdx = 0;
    showImage(0);
  }

  function showImage(idx){
    if(idx < 0 || idx >= visibleImgs.length) return;
    currentIdx = idx;
    visibleImgs.forEach(function(im,i){ im.classList.toggle('grl-gal__img--active', i===idx); });
    visibleThumbs.forEach(function(t,i){ t.classList.toggle('grl-gal__thumb--active', i===idx); });
    // scroll active thumb into view
    var at = visibleThumbs[idx];
    if(at) at.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
  }

  // ---- Thumbnail clicks ----
  thumbsEl.addEventListener('click', function(e){
    var thumb = e.target.closest('[data-grl-thumb]');
    if(!thumb) return;
    var mediaId = thumb.getAttribute('data-media-id');
    var i = visibleImgs.findIndex(function(im){ return im.getAttribute('data-media-id')===mediaId; });
    if(i >= 0) showImage(i);
  });

  // ---- Main area: mouse cursor chevron ----
  var chevronX = 0, chevronY = 0, animating = false;
  function positionChevron(){
    chevronEl.style.transform = 'translate(' + (chevronX - {{ chevron_size | divided_by: 2 }}) + 'px,' + (chevronY - {{ chevron_size | divided_by: 2 }}) + 'px)';
    if(animating) requestAnimationFrame(positionChevron);
  }

  mainEl.addEventListener('mouseenter', function(){
    if(isMobile) return;
    chevronEl.classList.add('grl-gal__chevron--visible');
    animating = true; positionChevron();
  });
  mainEl.addEventListener('mouseleave', function(){
    chevronEl.classList.remove('grl-gal__chevron--visible');
    animating = false; chevronSide = null;
  });
  mainEl.addEventListener('mousemove', function(e){
    if(isMobile) return;
    var rect = mainEl.getBoundingClientRect();
    chevronX = e.clientX - rect.left;
    chevronY = e.clientY - rect.top;
    var half = rect.width / 2;
    var newSide = chevronX < half ? 'left' : 'right';
    if(newSide !== chevronSide){
      chevronSide = newSide;
      chevronEl.classList.toggle('grl-gal__chevron--left', newSide === 'left');
    }
  });

  // ---- Main area: click to nav ----
  mainEl.addEventListener('click', function(e){
    if(e.target.closest('[data-grl-thumb]')) return;
    var rect = mainEl.getBoundingClientRect();
    var x = e.clientX - rect.left;
    var half = rect.width / 2;
    if(x < half){
      // prev
      showImage(currentIdx > 0 ? currentIdx - 1 : visibleImgs.length - 1);
    } else {
      // next
      showImage(currentIdx < visibleImgs.length - 1 ? currentIdx + 1 : 0);
    }
  });

  // ---- Mobile: swipe support ----
  var touchStartX = 0;
  mainEl.addEventListener('touchstart', function(e){ touchStartX = e.touches[0].clientX; }, { passive: true });
  mainEl.addEventListener('touchend', function(e){
    var dx = e.changedTouches[0].clientX - touchStartX;
    if(Math.abs(dx) < 40) return;
    if(dx < 0) showImage(currentIdx < visibleImgs.length - 1 ? currentIdx + 1 : 0);
    else showImage(currentIdx > 0 ? currentIdx - 1 : visibleImgs.length - 1);
  }, { passive: true });

  // ---- Wire into variant picker ----
  function handleVariant(){
    var c = document.querySelector('input[name="grl_type"]:checked');
    if(c) filterVariant(c.value);
  }
  document.addEventListener('change', function(e){
    if(e.target && e.target.name === 'grl_type') setTimeout(handleVariant, 30);
  }, true);
  document.addEventListener('click', function(e){
    var lbl = e.target && e.target.closest && e.target.closest('label.grl-variant-label');
    if(lbl){ var inp = lbl.querySelector('input[name="grl_type"]'); if(inp) setTimeout(function(){ filterVariant(inp.value); }, 40); }
  }, true);

  // ---- Responsive ----
  window.matchMedia('(max-width:749px)').addEventListener('change', function(e){ isMobile = e.matches; });

  // ---- Init ----
  handleVariant();
})();
</script>
{%- endif -%}
