{%- comment -%}
  GRL — Variant-based product media filtering
  ------------------------------------------------------------------
  Each variant has exactly ONE image assigned in Shopify (its featured
  media). That assigned image acts as a BOUNDARY MARKER in the gallery.
  A variant "owns" every image from its own marker up to (but not
  including) the next variant's marker. The last variant owns everything
  from its marker to the end of the gallery.

  Hiding is driven by a single persistent <style> rule keyed on
  data-media-id (slides) and position (thumbnails). Because it is pure
  CSS, it applies INSTANTLY to any slide the theme inserts — including
  the slides Horizon re-renders when a variant changes — so there is no
  flash-of-all-images and no race with the theme's own gallery logic.

  Single-variant products are skipped (no filtering needed).
{%- endcomment -%}
{%- if request.page_type == 'product' and product.variants.size > 1 -%}
<script>
(function () {
  if (window.__grlVImg || window.__grlGal) return; window.__grlVImg = true;

  // ---- Server-rendered data -------------------------------------------
  var MEDIA_ORDER = [{% for m in product.media %}"{{ m.id }}"{% unless forloop.last %},{% endunless %}{% endfor %}];
  var VARIANTS = [
    {% for v in product.variants -%}
    { title: {{ v.title | json }}, media: {% if v.featured_media %}"{{ v.featured_media.id }}"{% else %}null{% endif %} }{% unless forloop.last %},{% endunless %}
    {% endfor -%}
  ];
  if (!MEDIA_ORDER.length || VARIANTS.length < 2) return;

  // ---- Build per-variant segments from boundary markers ----------------
  var norm = function (s) { return (s == null ? '' : String(s)).trim().toLowerCase(); };
  var marks = [];
  VARIANTS.forEach(function (v) {
    if (!v.media) return;
    var idx = MEDIA_ORDER.indexOf(v.media);
    if (idx < 0) return;
    marks.push({ title: v.title, start: idx });
  });
  if (marks.length < 2) return;
  marks.sort(function (a, b) { return a.start - b.start; });
  marks[0].start = 0; // absorb any leading un-assigned images into 1st variant

  // For each variant: which media indices to HIDE (everything outside its segment)
  var HIDE = {};           // normalized title -> [mediaIndex,...]
  var ORDER = [];          // normalized titles in display order
  marks.forEach(function (m, i) {
    var end = (i + 1 < marks.length) ? marks[i + 1].start : MEDIA_ORDER.length;
    var keep = {};
    for (var k = m.start; k < end; k++) keep[k] = 1;
    var hide = [];
    for (var j = 0; j < MEDIA_ORDER.length; j++) if (!keep[j]) hide.push(j);
    var t = norm(m.title);
    HIDE[t] = hide;
    ORDER.push(t);
  });

  // ---- Persistent style rule ------------------------------------------
  var styleEl = document.createElement('style');
  styleEl.id = 'grl-vimg-style';
  (document.head || document.documentElement).appendChild(styleEl);

  var current = null;

  function buildRule(title) {
    var hide = HIDE[title];
    if (!hide || !hide.length) return '';
    var slideSel = [], thumbSel = [];
    hide.forEach(function (i) {
      var id = MEDIA_ORDER[i];
      slideSel.push('slideshow-slide:has(.product-media[data-media-id="' + id + '"])');
      slideSel.push('slideshow-slide:has([data-media-id="' + id + '"])');
      // thumbnails render in the same order as the slides
      thumbSel.push('.slideshow-controls__thumbnails > button:nth-of-type(' + (i + 1) + ')');
    });
    var css = slideSel.join(',') + '{display:none!important}';
    if (thumbSel.length) css += thumbSel.join(',') + '{display:none!important}';
    return css;
  }

  function setVariant(title) {
    title = norm(title);
    if (!(title in HIDE)) return;
    current = title;
    var rule = buildRule(title);
    if (styleEl.textContent !== rule) styleEl.textContent = rule;
    requestAnimationFrame(scrollToFirst);
    setTimeout(scrollToFirst, 140);
  }

  function reassert() {
    // adopt the currently-checked variant (or keep current) and ensure the rule is live
    var c = document.querySelector('input[name="grl_type"]:checked');
    var t = c ? norm(c.value) : current;
    if (!t || !(t in HIDE)) t = current || ORDER[0];
    if (!t) return;
    current = t;
    var rule = buildRule(t);
    if (styleEl.textContent !== rule) styleEl.textContent = rule;
  }

  // ---- Scroll the gallery to the first visible (in-segment) slide ------
  function scrollToFirst() {
    var sc = document.querySelector('slideshow-slides[ref="scroller"]')
          || document.querySelector('slideshow-slides');
    if (!sc) return;
    var slides = sc.querySelectorAll('slideshow-slide');
    var first = null;
    for (var i = 0; i < slides.length; i++) {
      var s = slides[i];
      if (s.offsetParent !== null && getComputedStyle(s).display !== 'none') { first = s; break; }
    }
    if (!first) return;
    try {
      var delta = first.getBoundingClientRect().left - sc.getBoundingClientRect().left;
      if (Math.abs(delta) > 1) sc.scrollLeft += delta;
    } catch (e) {}
  }

  // ---- Wiring ----------------------------------------------------------
  // Update the rule the instant the user picks a variant (value is already
  // set on the input by the time these bubble up), BEFORE the theme re-renders.
  document.addEventListener('change', function (e) {
    if (e.target && e.target.name === 'grl_type') setVariant(e.target.value);
  }, true);
  document.addEventListener('click', function (e) {
    var lbl = e.target && e.target.closest && e.target.closest('label.grl-variant-label');
    if (lbl) {
      var inp = lbl.querySelector('input[name="grl_type"]');
      if (inp) setVariant(inp.value);
    } else if (e.target && e.target.name === 'grl_type') {
      setVariant(e.target.value);
    }
  }, true);

  // Re-assert + re-scroll whenever the gallery DOM changes (variant re-render).
  var deb;
  var mo = new MutationObserver(function (recs) {
    var relevant = false;
    for (var i = 0; i < recs.length; i++) {
      var r = recs[i];
      if (r.addedNodes.length || r.removedNodes.length) { relevant = true; break; }
    }
    if (!relevant) return;
    clearTimeout(deb);
    deb = setTimeout(function () { reassert(); scrollToFirst(); }, 30);
  });

  function start() {
    reassert();                 // set initial rule from checked variant
    scrollToFirst();
    var target = document.querySelector('media-gallery') || document.body;
    // observe a stable ancestor so full gallery re-renders are still caught
    mo.observe(target.parentElement || target, { childList: true, subtree: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }
  window.addEventListener('load', function () { reassert(); scrollToFirst(); });
})();
</script>
{%- endif -%}
